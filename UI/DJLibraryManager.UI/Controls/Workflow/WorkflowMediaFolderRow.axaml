<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowMediaFolderRow"
    x:Name="Root">

    <Border
        Padding="0"
        Margin="0,2">

        <Grid
            Height="30"
            ColumnDefinitions="*,90,90,90"
            VerticalAlignment="Center">

            <!-- ===================================================== -->
            <!-- Folder -->
            <!-- ===================================================== -->

            <Button
                Grid.Column="0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                Click="FolderButton_Click">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">

                    <TextBlock
                        FontSize="12"
                        VerticalAlignment="Center"
                        Text="📁"/>

                    <TextBlock
                        FontSize="12"
                        VerticalAlignment="Center"
                        Text="{Binding Folder, ElementName=Root}"
                        TextTrimming="CharacterEllipsis"/>

                </StackPanel>

            </Button>

            <!-- ===================================================== -->
            <!-- Audio -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="1"
                FontSize="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding AudioCount,
                               ElementName=Root,
                               StringFormat={}{0:N0}}"/>

            <!-- ===================================================== -->
            <!-- Video -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="2"
                FontSize="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding VideoCount,
                               ElementName=Root,
                               StringFormat={}{0:N0}}"/>

            <!-- ===================================================== -->
            <!-- Total -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="3"
                FontSize="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding TotalCount,
                               ElementName=Root,
                               StringFormat={}{0:N0}}"/>

        </Grid>

    </Border>

</UserControl>