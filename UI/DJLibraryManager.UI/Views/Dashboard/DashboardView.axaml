<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:cards="using:DJLibraryManager.UI.Controls.Cards"
    xmlns:panels="using:DJLibraryManager.UI.Controls.Panels"
    xmlns:navigation="using:DJLibraryManager.UI.Controls.Navigation"
    xmlns:views="using:DJLibraryManager.UI.Views"
    x:Class="DJLibraryManager.UI.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    mc:Ignorable="d">

<Border
    Classes="card"
    Padding="25">

    <Grid
        RowDefinitions="*"
        ColumnDefinitions="660,*"
        ColumnSpacing="22">

        <!-- ===================================================== -->
        <!-- LEFT -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="0"
            Grid.Column="0"
            RowDefinitions="Auto,Auto,*,12,Auto"
            VerticalAlignment="Stretch">

            <!-- ===================================================== -->
            <!-- Top Left Header -->
            <!-- ===================================================== -->

            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                VerticalAlignment="Top">

                <!-- Left -->

                <StackPanel>

                    <Image
                        Height="24"
                        HorizontalAlignment="Left"
                        Stretch="Uniform"
                        Source="avares://DJLibraryManager.UI/Assets/Logos/DIASISS_WordMark.png"/>

                    <TextBlock
                        Margin="0,10,0,0"
                        Classes="body"
                        Text="Installed DJ software and media locations have been automatically discovered."/>

                </StackPanel>

                <!-- Right -->

                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Theme="{StaticResource DJLM.PrimaryButton}"
                    Command="{Binding GoDashboardCommand}"
                    Content="🏠 Dashboard"/>

            </Grid>

            <!-- ===================================================== -->
            <!-- Installed Providers -->
            <!-- ===================================================== -->

            <Border
                Grid.Row="1"
                Classes="card"
                Padding="12"
                Margin="0,22,0,22">

                <StackPanel
                    Spacing="12">

                    <TextBlock
                        Classes="section"
                        Text="Installed DJ Software"/>

                    <ItemsControl
                        ItemsSource="{Binding InstalledProviders}">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <WrapPanel
                                    Orientation="Horizontal"/>

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <cards:ProviderCard/>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>


        <!-- ===================================================== -->
        <!-- Media Locations -->
        <!-- ===================================================== -->

    <Border
    Grid.Row="2"
    Classes="card"
    Padding="12">

    <Grid
        RowDefinitions="Auto,*"
        RowSpacing="12">

        <TextBlock
            Grid.Row="0"
            Classes="section"
            Text="Media Locations"/>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <ItemsControl
                ItemsSource="{Binding MediaLocations}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <navigation:NavigationRow
                            Icon="📁"
                            Text="{Binding Path}"

                            LeftCommand="{Binding $parent[views:DashboardView].OpenMediaLocationCommand}"
                            LeftCommandParameter="{Binding}"

                            RightCommand="{Binding $parent[views:DashboardView].SelectMediaLocationCommand}"
                            RightCommandParameter="{Binding}" />

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Border>

       <Border Grid.Row="3"/>

    <!-- ===================================================== -->
    <!-- Library Overview -->
    <!-- ===================================================== -->

            <Border
                Grid.Row="4"
                Classes="card-secondary"
                Padding="12">

                <StackPanel
                    Spacing="12">

                    <TextBlock
                        Classes="section"
                        Text="Library Overview"/>

                    <cards:LibraryOverviewCard
                        DataContext="{Binding LibraryOverview}"/>

                </StackPanel>

            </Border>

</Grid>

            <!-- ===================================================== -->
            <!-- RIGHT -->
            <!-- ===================================================== -->

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Classes="card"
                Padding="20"
                VerticalAlignment="Stretch">

            <ContentControl
                Content="{Binding CurrentWorkspace}" />

            </Border>

        </Grid>

    </Border>

</UserControl>