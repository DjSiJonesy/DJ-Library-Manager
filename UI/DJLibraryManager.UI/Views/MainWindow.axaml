<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:cards="using:DJLibraryManager.UI.Controls.Cards"
    x:Class="DJLibraryManager.UI.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d"
    Width="1005"
    Height="800"
    MinWidth="1010"
    MinHeight="750"
    Title="DJ Library Manager"
    Background="{DynamicResource Brush.Background}">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Classes="display"
                Text="DJ Library Manager"/>

            <TextBlock
                Classes="subheading"
                Margin="0,4,0,0"
                Text="by SMSounds"/>

        </StackPanel>

        <!-- Main Card -->

        <Border
    Grid.Row="2"
    Classes="card"
    Padding="30">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->

        <StackPanel
            Grid.Row="0"
            Spacing="14">

            <TextBlock
                Classes="heading"
                Text="Startup Discovery"/>

            <TextBlock
                Classes="body"
                Text="The application will automatically discover installed DJ software and music libraries before beginning analysis."/>

            <!-- Installed Providers -->

            <TextBlock
                Classes="section"
                Margin="0,8,0,0"
                Text="Installed DJ Software"/>

            <ItemsControl ItemsSource="{Binding InstalledProviders}">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <cards:ProviderCard
                            ProviderName="{Binding Name}"
                            ProviderLogo="{Binding ProviderLogo}"
                            Status="{Binding Status}"/>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <!-- Music Locations -->

            <TextBlock
                Classes="section"
                Margin="0,8,0,0"
                Text="Music Locations"/>

            <ItemsControl
                Margin="12,0,0,0"
                ItemsSource="{Binding MusicLocations}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                           <TextBlock
                                Grid.Column="0"
                                FontSize="16"
                                VerticalAlignment="Center"
                                Text="📁"/>

                            <TextBlock
                                Grid.Column="1"
                                Classes="listitem"
                                VerticalAlignment="Center"
                                Text="{Binding}"/>

                        </Grid>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

        <!-- Footer -->

        <Border
            Grid.Row="1"
            Margin="0,24,0,0"
            BorderThickness="1,0,0,0"
            BorderBrush="{DynamicResource Brush.Border}"
            Padding="0,20,0,0">

            <Button
                Theme="{StaticResource DJLM.PrimaryButton}"
                HorizontalAlignment="Left"
                Content="Analyse Library"/>

        </Border>

    </Grid>

</Border>

        <!-- Footer -->

        <TextBlock
            Grid.Row="4"
            Classes="caption"
            HorizontalAlignment="Right"
            Text="{Binding StatusText}"/>

    </Grid>

</Window>