<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels.Analysis"
    xmlns:workflow="using:DJLibraryManager.UI.Controls.Workflow"
    x:Class="DJLibraryManager.UI.Views.Analysis.AnalysisWorkspaceView"
    x:DataType="vm:AnalysisWorkspaceViewModel">

    <Grid RowDefinitions="Auto,20,*">

        <!-- ===================================================== -->
        <!-- Header -->
        <!-- ===================================================== -->

        <workflow:WorkflowHeader
            Grid.Row="0"
            Title="Analysis"
            Description="Analyse the DIASISS library and identify issues before searching for improvements."
            PreviousText="← Import"
            PreviousCommand="{Binding PreviousCommand}"
            NextText="Search →"
            NextCommand="{Binding NextCommand}"
            ShowPrevious="True"
            ShowNext="True"
            ShowBackupProtection="True"
            ShowDuplicateProtection="False"/>

        <!-- ===================================================== -->
        <!-- Content -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="2"
            RowDefinitions="Auto,20,Auto,20,*">

            <!-- ================================================= -->
            <!-- Analysis Summary -->
            <!-- ================================================= -->

            <workflow:WorkflowAnalysisSummaryCard
                Grid.Row="0"

                TracksScanned="{Binding TracksScanned}"
                TotalTracks="{Binding TotalTracks}"

                IssuesFound="{Binding IssuesFound}"
                HealthScore="{Binding HealthScore}"

                LastAnalysed="{Binding LastAnalysed}"

                Progress="{Binding Progress}"

                Status="{Binding Status}"
                StatusBrush="{Binding StatusBrush}"
                CurrentTrack="{Binding CurrentTrack}"

                AnalyseCommand="{Binding AnalyseLibraryCommand}" />

            <!-- ================================================= -->
            <!-- Issue Breakdown -->
            <!-- ================================================= -->

            <workflow:WorkflowAnalysisTable
                Grid.Row="2"
                Categories="{Binding Categories}" />

            <!-- ================================================= -->
            <!-- Selected Category Details -->
            <!-- ================================================= -->

            <workflow:WorkflowAnalysisDetailCard
                Grid.Row="4" />

        </Grid>

    </Grid>

</UserControl>