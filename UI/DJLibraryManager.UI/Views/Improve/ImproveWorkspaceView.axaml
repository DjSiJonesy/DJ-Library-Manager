<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels.Improve"
    xmlns:models="using:DJLibraryManager.UI.Models.Improve"
    xmlns:workflow="using:DJLibraryManager.UI.Controls.Workflow"
    x:Class="DJLibraryManager.UI.Views.Improve.ImproveWorkspaceView"
    x:DataType="vm:ImproveWorkspaceViewModel">

    <Grid RowDefinitions="Auto,20,*">

        <!-- ===================================================== -->
        <!-- Improve Header -->
        <!-- ===================================================== -->

        <workflow:WorkflowHeader
            Grid.Row="0"
            Title="Improve"
            Description="Apply the changes selected during Search to the DIASISS library."
            PreviousText="← Search"
            PreviousCommand="{Binding PreviousCommand}"
            NextText="Structure →"
            NextCommand="{Binding NextCommand}"
            ShowPrevious="True"
            ShowNext="True"
            ShowDuplicateProtection="True"
            ShowBackupProtection="False"/>


        <!-- ===================================================== -->
        <!-- Improve Workspace -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="2"
            RowDefinitions="Auto,20,*">


            <!-- ================================================= -->
            <!-- Category Buttons -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12">

                <ItemsControl
                    Grid.Column="0"
                    ItemsSource="{Binding Categories}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:ImproveCategoryInfo">

                            <Button
                                Theme="{StaticResource DJLM.PrimaryButton}"
                                Padding="12,8"
                                MinWidth="170"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectCategoryCommand}"
                                CommandParameter="{Binding}">

                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="16"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Text="{Binding Icon}"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0"
                                        Text="{Binding Count, StringFormat={}{0:N0}}"/>

                                </Grid>

                            </Button>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>


                <!-- ================================================= -->
                <!-- Open DIASISS Duplicates Folder -->
                <!-- ================================================= -->

                <Button
                    Grid.Column="1"
                    Theme="{StaticResource DJLM.SecondaryButton}"
                    Padding="12,8"
                    MinHeight="46"
                    VerticalAlignment="Center"
                    Content="📂 Open DIASISS Duplicates Folder"
                    Command="{Binding OpenDuplicatesCommand}"
                    IsVisible="{Binding IsDuplicatesCategory}"/>

            </Grid>


            <!-- ================================================= -->
            <!-- Single Improve Workspace Card -->
            <!-- ================================================= -->

            <Border
                Grid.Row="2"
                Classes="card-secondary"
                Padding="20">

                <Grid>


                    <!-- ================================================= -->
                    <!-- DUPLICATES -->
                    <!-- ================================================= -->

                    <Grid
                        IsVisible="{Binding IsDuplicatesCategory}"
                        RowDefinitions="Auto,12,Auto,16,Auto,Auto,16,*,Auto">


                        <!-- ============================================= -->
                        <!-- Section Heading -->
                        <!-- ============================================= -->

                        <TextBlock
                            Grid.Row="0"
                            Classes="heading"
                            HorizontalAlignment="Center"
                            Text="Duplicate Changes Ready to Apply"/>


                        <!-- ============================================= -->
                        <!-- Description -->
                        <!-- ============================================= -->

                        <TextBlock
                            Grid.Row="2"
                            FontSize="13"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            Text="The selected individual copies will be retained. All other duplicate files will be moved to the DIASISS Duplicates folder."
                            TextWrapping="Wrap"/>


                        <!-- ============================================= -->
                        <!-- Main Information -->
                        <!-- ============================================= -->

                        <Grid
                            Grid.Row="4"
                            ColumnDefinitions="*,40,*"
                            VerticalAlignment="Top">

                            <!-- ========================================= -->
                            <!-- Left Side - Selection -->
                            <!-- ========================================= -->

                            <Border
                                Grid.Column="0"
                                Padding="12">

                                <StackPanel
                                    Spacing="8">

                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Duplicate Selection"/>

                                    <TextBlock
                                        Classes="caption"
                                        Text="The selections made during Search determine which individual copies will be retained and which files will be moved to DIASISS Duplicates."
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Classes="caption"
                                        Margin="0,8,0,0"
                                        Text="These changes are based entirely on the selections made in the Search workspace. Improve will not perform another search."
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>


                            <!-- ========================================= -->
                            <!-- Right Side - Summary -->
                            <!-- ========================================= -->

                            <Border
                                Grid.Column="2"
                                Padding="12">

                                <StackPanel
                                    Spacing="7">

                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Duplicate Summary"/>

                                    <Grid
                                        ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="12"
                                            Text="Files with duplicate/multiple copies"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Margin="20,0,0,0"
                                            Text="{Binding SelectedCategory.Count, StringFormat={}{0:N0}}"/>

                                    </Grid>

                                    <Grid
                                        ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="12"
                                            Text="Total files"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Margin="20,0,0,0"
                                            Text="{Binding TotalDuplicates, StringFormat={}{0:N0}}"/>

                                    </Grid>

                                    <Grid
                                        ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="12"
                                            Text="Individual copies selected to keep"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Margin="20,0,0,0"
                                            Text="{Binding DuplicatesToKeep, StringFormat={}{0:N0}}"/>

                                    </Grid>

                                    <Grid
                                        ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="12"
                                            Text="Files to be moved to DIASISS Duplicates"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Margin="20,0,0,0"
                                            Text="{Binding DuplicatesToMove, StringFormat={}{0:N0}}"/>

                                    </Grid>

                                </StackPanel>

                            </Border>

                        </Grid>


                        <!-- ============================================= -->
                        <!-- Operation Result + Restore Changes -->
                        <!-- ============================================= -->

                        <Grid
                            Grid.Row="5"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="16">

                            <!-- ========================================= -->
                            <!-- Operation Result -->
                            <!-- ========================================= -->

                            <Border
                                Grid.Column="0"
                                Classes="card-secondary"
                                Padding="12">

                                <StackPanel
                                    Spacing="6">

                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Operation Result"/>

                                    <TextBlock
                                        FontSize="13"
                                        Text="{Binding OperationResult}"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>


                            <!-- ========================================= -->
                            <!-- Restore Changes -->
                            <!-- ========================================= -->

                            <Border
                                Grid.Column="1"
                                Classes="card-secondary"
                                Padding="12">

                                <Grid
                                    RowDefinitions="Auto,Auto,Auto,Auto"
                                    RowSpacing="8">

                                    <TextBlock
                                        Grid.Row="0"
                                        Text="Restore Changes"
                                        FontSize="14"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Row="1"
                                        Text="Select the point in time from which changes should be restored. The selected operation and every operation after it will be restored. Earlier operations will remain unchanged."
                                        FontSize="11"
                                        TextWrapping="Wrap"/>

                                    <Grid
                                        Grid.Row="2"
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10">

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="Restore from:"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"/>

                                        <ComboBox
                                            Grid.Column="1"
                                            ItemsSource="{Binding RestorePoints}"
                                            SelectedItem="{Binding SelectedRestorePoint, Mode=TwoWay}"
                                            FontSize="12"
                                            HorizontalAlignment="Stretch">

                                            <ComboBox.ItemTemplate>

                                                <DataTemplate>

                                                    <TextBlock
                                                        Text="{Binding DisplaySummary}"
                                                        FontSize="12"/>

                                                </DataTemplate>

                                            </ComboBox.ItemTemplate>

                                        </ComboBox>

                                    </Grid>

                                    <Border
                                        Grid.Row="3"
                                        Classes="card-secondary"
                                        Padding="10"
                                        MinHeight="60">

                                        <Grid
                                            RowDefinitions="Auto,Auto"
                                            RowSpacing="6">

                                            <TextBlock
                                                Grid.Row="0"
                                                Text="Changes to be Restored"
                                                FontSize="12"
                                                FontWeight="SemiBold"/>

                                            <TextBlock
                                                Grid.Row="1"
                                                Text="{Binding SelectedRestorePoint.DisplayRestoreSummary}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"/>

                                        </Grid>

                                    </Border>

                                </Grid>

                            </Border>

                        </Grid>


                        <!-- ============================================= -->
                        <!-- Spacer -->
                        <!-- ============================================= -->

                        <Border
                            Grid.Row="6"/>


                        <!-- ============================================= -->
                        <!-- Flexible Space -->
                        <!-- ============================================= -->

                        <Border
                            Grid.Row="7"/>


                        <!-- ============================================= -->
                        <!-- Actions - Fixed at Bottom -->
                        <!-- ============================================= -->

                        <StackPanel
                            Grid.Row="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">

                            <Button
                                Theme="{StaticResource DJLM.SecondaryButton}"
                                Content="Back to Search"
                                Command="{Binding PreviousCommand}"/>

                            <Button
                                Theme="{StaticResource DJLM.PrimaryButton}"
                                Content="Remove Duplicates"
                                Command="{Binding ConfirmCommand}"/>

                            <Button
                                Theme="{StaticResource DJLM.SecondaryButton}"
                                Content="Restore Selected Changes"
                                Command="{Binding RestoreSelectedChangesCommand}"/>

                        </StackPanel>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- MISSING FILES -->
                    <!-- ================================================= -->

                    <Grid
                        IsVisible="{Binding IsMissingFilesCategory}"
                        RowDefinitions="Auto,12,Auto,16,Auto,20,Auto,*,Auto">

                        <TextBlock
                            Grid.Row="0"
                            Classes="heading"
                            HorizontalAlignment="Center"
                            Text="Missing Files Found"/>

                        <TextBlock
                            Grid.Row="2"
                            FontSize="13"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            Text="DIASISS has identified provider records for files that are no longer present at their recorded locations."
                            TextWrapping="Wrap"/>

                        <Grid
                            Grid.Row="4"
                            ColumnDefinitions="*,40,*"
                            VerticalAlignment="Top">

                            <Border
                                Grid.Column="0"
                                Padding="12">

                                <StackPanel
                                    Spacing="8">

                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Provider Cleanup"/>

                                    <TextBlock
                                        Classes="caption"
                                        Text="DIASISS does not modify Provider databases. The missing-file records must be removed using the originating DJ application's own database tools."
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Classes="caption"
                                        Margin="0,8,0,0"
                                        Text="Select View Removal Instructions to see the procedure for each affected Provider."
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Column="2"
                                Padding="12">

                                <StackPanel
                                    Spacing="7">

                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Missing File Summary"/>

                                    <Grid
                                        ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="13"
                                            Text="Missing files identified"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Margin="20,0,0,0"
                                            Text="{Binding SelectedCategory.Count, StringFormat={}{0:N0}}"/>

                                    </Grid>

                                    <TextBlock
                                        Classes="caption"
                                        Margin="0,8,0,0"
                                        Text="The affected Provider records can be cleaned up using their own database tools."
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                        </Grid>


                        <Border
                            Grid.Row="6"
                            Classes="card-secondary"
                            Padding="12">

                            <StackPanel
                                Spacing="6">

                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Provider Cleanup Instructions"/>

                                <TextBlock
                                    FontSize="13"
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap"/>

                                <ItemsControl
                                    Margin="0,8,0,0"
                                    ItemsSource="{Binding ProviderRemovalInstructions}"
                                    IsVisible="{Binding ProviderRemovalInstructions.Count}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="10"
                                                Margin="0,2">

                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="•"/>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="12"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding ProviderName}"/>

                                            </Grid>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </Border>


                        <Border
                            Grid.Row="7"/>


                        <StackPanel
                            Grid.Row="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">

                            <Button
                                Theme="{StaticResource DJLM.SecondaryButton}"
                                Content="Back to Search"
                                Command="{Binding PreviousCommand}"/>

                            <Button
                                Theme="{StaticResource DJLM.PrimaryButton}"
                                Content="View Removal Instructions"
                                Command="{Binding ViewRemovalInstructionsCommand}"/>

                        </StackPanel>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- METADATA -->
                    <!-- ================================================= -->

                    <Grid
                        IsVisible="{Binding IsMetadataCategory}"
                        RowDefinitions="Auto,12,Auto,20,*,20,Auto">

                        <TextBlock
                            Grid.Row="0"
                            Classes="heading"
                            HorizontalAlignment="Center"
                            Text="Metadata Changes Ready to Apply"/>

                        <TextBlock
                            Grid.Row="2"
                            FontSize="13"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            Text="Apply selected metadata changes from Search or import an edited metadata export file."
                            TextWrapping="Wrap"/>

                        <Grid
                            Grid.Row="4"
                            ColumnDefinitions="*,40,*"
                            VerticalAlignment="Center">

                            <Border
                                Grid.Column="0"
                                Classes="card-secondary"
                                Padding="16">

                                <Grid
                                    RowDefinitions="*,Auto"
                                    RowSpacing="12">

                                    <StackPanel
                                        Grid.Row="0"
                                        Spacing="10">

                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="Selected Search Changes"/>

                                        <TextBlock
                                            Classes="caption"
                                            Text="Use the metadata changes selected in the Search workspace."
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Classes="caption"
                                            Margin="0,4,0,0"
                                            Text="{Binding Status}"
                                            TextWrapping="Wrap"/>

                                    </StackPanel>

                                    <Button
                                        Grid.Row="1"
                                        Theme="{StaticResource DJLM.PrimaryButton}"
                                        Content="Use Selected Changes"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ConfirmCommand}"/>

                                </Grid>

                            </Border>


                            <Border
                                Grid.Column="2"
                                Classes="card-secondary"
                                Padding="16">

                                <Grid
                                    RowDefinitions="*,Auto"
                                    RowSpacing="12">

                                    <StackPanel
                                        Grid.Row="0"
                                        Spacing="10">

                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="Import Edited Metadata"/>

                                        <TextBlock
                                            Classes="caption"
                                            Text="Import an edited metadata export after making the required manual changes."
                                            TextWrapping="Wrap"/>

                                    </StackPanel>

                                    <Button
                                        Grid.Row="1"
                                        Theme="{StaticResource DJLM.SecondaryButton}"
                                        Content="Import Metadata File"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ImportMetadataCommand}"/>

                                </Grid>

                            </Border>

                        </Grid>


                        <StackPanel
                            Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                            <Button
                                Theme="{StaticResource DJLM.SecondaryButton}"
                                Content="Back to Search"
                                Command="{Binding PreviousCommand}"/>

                        </StackPanel>

                    </Grid>


                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>