<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels.Import"
    xmlns:workflow="using:DJLibraryManager.UI.Controls.Workflow"
    x:Class="DJLibraryManager.UI.Views.Import.ImportWorkspaceView"
    x:DataType="vm:ImportWorkspaceViewModel">

    <Grid RowDefinitions="Auto,20,*">

        <!-- ===================================================== -->
        <!-- Header -->
        <!-- ===================================================== -->

       <workflow:WorkflowHeader
            Grid.Row="0"
            Title="Import"
            Description="1st: Import DJ provider libraries. 2nd: Import the discovered media into the DIASISS master library."
            PreviousText="← Discovery"
            PreviousCommand="{Binding GoDiscoveryCommand}"
            NextText="Analysis →"
            NextCommand="{Binding GoAnalysisCommand}"
            ShowPrevious="True"
            ShowNext="True"/>

        <!-- ===================================================== -->
        <!-- Content -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="2"
            RowDefinitions="Auto,20,Auto,20,Auto">

            <!-- ===================================================== -->
            <!-- Providers -->
            <!-- ===================================================== -->

            <workflow:WorkflowProviderImportTable
                Grid.Row="0"

                Providers="{Binding InstalledProviders}"

                ProviderCount="{Binding ProviderCount}"
                TotalTracks="{Binding TotalTracks}"
                TotalPlaylists="{Binding TotalPlaylists}"
                
                ImportCommand="{Binding ImportProviderCommand}" />

            <!-- ===================================================== -->
            <!-- Media Locations -->
            <!-- ===================================================== -->

            <workflow:WorkflowMediaLocationImportTable
                Grid.Row="2"

                MediaLocations="{Binding MediaLocations}"

                LocationCount="{Binding TotalDrives}"
                TotalTracks="{Binding TotalAudioFiles}"
                TotalExisting="{Binding TotalExisting}"
                TotalImported="{Binding TotalImported}"
                TotalFailed="{Binding TotalFailed}"

                ImportCommand="{Binding ImportMediaCommand}" />

            <!-- ===================================================== -->
            <!-- Current Import Operation -->
            <!-- ===================================================== -->

            <Border
                Grid.Row="4"
                Classes="card-secondary"
                Padding="12"
                IsVisible="{Binding CurrentOperation.IsRunning}">

                <StackPanel Spacing="8">

                    <TextBlock
                        Classes="subheading"
                        Text="Current Import"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding CurrentOperation.OperationName}"/>

                    <TextBlock
                        Text="{Binding CurrentOperation.CurrentStage}"/>

                    <ProgressBar
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding CurrentOperation.Percentage}"
                        IsIndeterminate="{Binding CurrentOperation.IsIndeterminate}"/>

                    <TextBlock
                        FontSize="12"
                        Text="{Binding CurrentOperation.CurrentItem}"/>

                    <TextBlock
                        FontSize="12"
                        Text="{Binding CurrentOperation.CurrentValue,
                                       StringFormat={}Processed: {0:N0}}"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>