<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowHeader"
    x:Name="Root">

    <Grid
        RowDefinitions="Auto,6,Auto,8,Auto,6,Auto"
        ColumnDefinitions="*,Auto,10,Auto,10,Auto">

        <!-- ===================================================== -->
        <!-- Title -->
        <!-- ===================================================== -->

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Classes="heading"
            Text="{Binding Title, ElementName=Root}" />

        <!-- ===================================================== -->
        <!-- Previous -->
        <!-- ===================================================== -->

        <Button
            Grid.Row="0"
            Grid.Column="1"
            IsVisible="{Binding ShowPrevious, ElementName=Root}"
            Theme="{StaticResource DJLM.SecondaryButton}"
            Padding="12,4"
            MinHeight="32"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Command="{Binding PreviousCommand, ElementName=Root}"
            Content="{Binding PreviousText, ElementName=Root}" />

        <!-- ===================================================== -->
        <!-- Secondary -->
        <!-- ===================================================== -->

        <Button
            Grid.Row="0"
            Grid.Column="3"
            IsVisible="{Binding ShowSecondary, ElementName=Root}"
            Theme="{StaticResource DJLM.SecondaryButton}"
            Padding="12,4"
            MinHeight="32"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Command="{Binding SecondaryCommand, ElementName=Root}"
            Content="{Binding SecondaryText, ElementName=Root}" />

        <!-- ===================================================== -->
        <!-- Next -->
        <!-- ===================================================== -->

        <Button
            Grid.Row="0"
            Grid.Column="5"
            IsVisible="{Binding ShowNext, ElementName=Root}"
            Theme="{StaticResource DJLM.PrimaryButton}"
            Padding="12,4"
            MinHeight="32"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Command="{Binding NextCommand, ElementName=Root}"
            Content="{Binding NextText, ElementName=Root}" />

        <!-- ===================================================== -->
        <!-- Description -->
        <!-- ===================================================== -->

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="6"
            Classes="caption"
            Text="{Binding Description, ElementName=Root}"
            TextWrapping="Wrap" />

        <!-- ===================================================== -->
        <!-- Backup Protection -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="6"
            IsVisible="{Binding ShowBackupProtection, ElementName=Root}"
            Background="{StaticResource Brush.Brand.Gradient}"
            BorderBrush="#5A3A70"
            BorderThickness="1"
            CornerRadius="5"
            Padding="8,5">

            <TextBlock
                FontSize="11"
                TextWrapping="Wrap">

                <Run
                    Text="🛡 Backup Protection: "
                    FontWeight="SemiBold" />

                <Run
                    Text="Folders containing " />

                <Run
                    Text="Backup"
                    FontWeight="SemiBold" />

                <Run
                    Text=" in their name are excluded from this workflow and will not be modified by DIASISS." />

            </TextBlock>

        </Border>

        <!-- ===================================================== -->
        <!-- Duplicate Protection -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="6"
            Grid.Column="0"
            Grid.ColumnSpan="6"
            IsVisible="{Binding ShowDuplicateProtection, ElementName=Root}"
            Background="{StaticResource Brush.Brand.Gradient}"
            BorderBrush="#5A3A70"
            BorderThickness="1"
            CornerRadius="5"
            Padding="8,5">

            <TextBlock
                FontSize="11"
                TextWrapping="Wrap">

                <Run
                    Text="📁 Duplicate Protection: "
                    FontWeight="SemiBold" />

                <Run
                    Text="Duplicate copies you do not select to keep will not be deleted. They will be retained in " />

                <Run
                    Text="DIASISS Duplicates"
                    FontWeight="SemiBold" />

                <Run
                    Text=" during the Improve stage." />

            </TextBlock>

        </Border>

    </Grid>

</UserControl>