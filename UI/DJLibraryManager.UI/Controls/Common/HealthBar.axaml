<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DJLibraryManager.UI.Controls.Common.HealthBar"
    x:Name="Root">

    <StackPanel
        Spacing="6">

        <ProgressBar
            Minimum="0"
            Maximum="100"
            Height="10"
            Value="{Binding Value, ElementName=Root}"
            Foreground="{Binding HealthBrush, ElementName=Root}"/>

        <TextBlock
            HorizontalAlignment="Center"
            Classes="caption"
            Text="{Binding Value,
                           ElementName=Root,
                           StringFormat='{}{0}%'}"/>

    </StackPanel>

</UserControl>