<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:cards="using:DJLibraryManager.UI.Controls.Cards"
    x:Class="DJLibraryManager.UI.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    mc:Ignorable="d">

    <Border
        Classes="card"
        Padding="30">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Spacing="14">

                <TextBlock
                    Classes="heading"
                    Text="Startup Discovery"/>

                <TextBlock
                    Classes="body"
                    Text="The application will automatically discover installed DJ software and music libraries before beginning analysis."/>

                <TextBlock
                    Classes="section"
                    Margin="0,8,0,0"
                    Text="Installed DJ Software"/>

                <ItemsControl ItemsSource="{Binding InstalledProviders}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <cards:ProviderCard/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <TextBlock
                    Classes="section"
                    Margin="0,20,0,0"
                    Text="Selected Provider"/>

                <TextBlock
                    Classes="body"
                    Text="{Binding SelectedProviderName}" />

                <TextBlock
                    Classes="section"
                    Margin="0,20,0,0"
                    Text="Music Locations"/>

                <ItemsControl
                    Margin="12,0,0,0"
                    ItemsSource="{Binding MusicLocations}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8">

                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="16"
                                    VerticalAlignment="Center"
                                    Text="📁"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Classes="listitem"
                                    VerticalAlignment="Center"
                                    Text="{Binding}" />

                            </Grid>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

            <Border
                Grid.Row="1"
                Margin="0,24,0,0"
                BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource Brush.Border}"
                Padding="0,20,0,0">

                <Button
                    Theme="{StaticResource DJLM.PrimaryButton}"
                    HorizontalAlignment="Left"
                    Content="Analyse Library"/>

            </Border>

        </Grid>

    </Border>

</UserControl>