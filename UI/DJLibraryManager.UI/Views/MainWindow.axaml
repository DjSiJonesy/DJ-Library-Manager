<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:cards="using:DJLibraryManager.UI.Controls.Cards"
    x:Class="DJLibraryManager.UI.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d"
    Width="900"
    Height="650"
    MinWidth="800"
    MinHeight="600"
    Title="DJ Library Manager"
    Background="{DynamicResource Brush.Background}">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Classes="display"
                Text="DJ Library Manager"/>

            <TextBlock
                Classes="subheading"
                Margin="0,4,0,0"
                Text="by SMSounds"/>

        </StackPanel>

        <!-- Main Card -->

        <Border
            Grid.Row="2"
            Classes="card">

            <StackPanel Spacing="18">

                <TextBlock
                    Classes="heading"
                    Text="Startup Discovery"/>

                <TextBlock
                    Classes="body"
                    Text="The application will automatically discover installed DJ software and music libraries before beginning analysis."/>

<!-- Installed DJ Software -->

<TextBlock
    Classes="section"
    Margin="0,12,0,0"
    Text="Installed DJ Software"/>

<ItemsControl ItemsSource="{Binding InstalledProviders}">

    <ItemsControl.ItemsPanel>

        <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>

        <DataTemplate>

            <cards:ProviderCard
            ProviderName="{Binding Name}"
            ProviderLogo="{Binding ProviderLogo}"
            Status="{Binding Status}" />

        </DataTemplate>

    </ItemsControl.ItemTemplate>

</ItemsControl>

                <!-- Music Locations -->

                <TextBlock
                    Classes="section"
                    Margin="0,12,0,0"
                    Text="Music Locations"/>

                <ItemsControl ItemsSource="{Binding MusicLocations}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <TextBlock
                                Classes="listitem"
                                Text="{Binding}"/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <!-- Analyse Button -->

                <Button
                    Theme="{StaticResource DJLM.PrimaryButton}"
                    HorizontalAlignment="Left"
                    Content="Analyse Library"/>
 

            </StackPanel>

        </Border>

        <!-- Footer -->

        <TextBlock
            Classes="caption"
            Grid.Row="4"
            HorizontalAlignment="Right"
            Text="{Binding StatusText}"/>

    </Grid>

</Window>