<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:workflow="using:DJLibraryManager.UI.Controls.Workflow"
    xmlns:models="using:DJLibraryManager.UI.Models"
    x:Class="DJLibraryManager.UI.Views.DiscoveryWorkspaceView"
    x:DataType="vm:DiscoveryWorkspaceViewModel">

    <Grid RowDefinitions="Auto,20,*">

        <workflow:WorkflowHeader
            Grid.Row="0"
            Title="Discovery"
            Description="Auto-Discovery of your installed DJ software and the route media locations on your computer."

            ShowPrevious="False"

            ShowSecondary="True"
            SecondaryText="↻ Re-Scan"
            SecondaryCommand="{Binding ValidateDiscoveryCommand}"

            NextText="Import →"
            NextCommand="{Binding GoImportCommand}" />

        <!-- ===================================================== -->
        <!-- Content -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="2"
            ColumnDefinitions="260,20,*">

            <!-- ===================================================== -->
            <!-- Installed Providers -->
            <!-- ===================================================== -->

            <ItemsControl
                Grid.Column="0"
                ItemsSource="{Binding InstalledProviders}">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10"/>
                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:ProviderInfo">

                        <workflow:DiscoveryProviderRow
                            Provider="{Binding}" />

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <!-- ===================================================== -->
            <!-- Media Locations -->
            <!-- ===================================================== -->

            <workflow:WorkflowMediaLocationTable
                Grid.Column="2"

                MediaLocations="{Binding MediaLocations}"

                TotalFolders="{Binding TotalFolders}"
                TotalAudioFiles="{Binding TotalAudioFiles}"
                TotalVideoFiles="{Binding TotalVideoFiles}"
                TotalDrives="{Binding TotalDrives}"

                DiscoverCommand="{Binding DiscoverMediaCommand}"
                ViewCommand="{Binding ViewMediaLocationCommand}" />

        </Grid>

    </Grid>

</UserControl>