<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowProviderImportRow"
    x:Name="Root">

    <Border
        Padding="8,6">

        <Grid
            ColumnDefinitions="220,170,90,90,180,*"
            VerticalAlignment="Center">

            <!-- ===================================================== -->
            <!-- Provider -->
            <!-- ===================================================== -->

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">

                <Border
                    Width="20"
                    Height="20"
                    CornerRadius="3"
                    ClipToBounds="True">

                    <Image
                        Width="20"
                        Height="20"
                        Stretch="Uniform"
                        Source="{Binding Provider.ProviderLogo, ElementName=Root}" />

                </Border>

                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding Provider.Name, ElementName=Root}" />

            </StackPanel>

            <!-- ===================================================== -->
            <!-- Status -->
            <!-- ===================================================== -->

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="6">

                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{Binding Provider.LibraryStatusBrush, ElementName=Root}" />

                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding Provider.LibraryStatus, ElementName=Root}" />

            </StackPanel>

            <!-- ===================================================== -->
            <!-- Tracks -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding Provider.TrackCount, ElementName=Root, StringFormat={}{0:N0}}" />

            <!-- ===================================================== -->
            <!-- Playlists -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding Provider.PlaylistCount, ElementName=Root, StringFormat={}{0:N0}}" />

            <!-- ===================================================== -->
            <!-- Last Import -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="4"
                VerticalAlignment="Center"
                Text="{Binding Provider.LastImported, ElementName=Root, TargetNullValue=Never}" />

            <!-- ===================================================== -->
            <!-- Action -->
            <!-- ===================================================== -->

            <Button
                Grid.Column="5"
                Width="90"
                HorizontalAlignment="Center"
                Theme="{StaticResource DJLM.SmallPrimaryButton}"
                Command="{Binding ImportCommand, ElementName=Root}"
                CommandParameter="{Binding Provider, ElementName=Root}"
                Content="{Binding Provider.ImportActionText, ElementName=Root}" />

        </Grid>

    </Border>

</UserControl>