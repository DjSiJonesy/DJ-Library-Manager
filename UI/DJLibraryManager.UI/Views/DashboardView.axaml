<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:cards="using:DJLibraryManager.UI.Controls.Cards"
    xmlns:panels="using:DJLibraryManager.UI.Controls.Panels"
    xmlns:navigation="using:DJLibraryManager.UI.Controls.Navigation"
    xmlns:views="using:DJLibraryManager.UI.Views"
    x:Class="DJLibraryManager.UI.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    mc:Ignorable="d">

    <Border
        Classes="card"
        Padding="25">
        

            <Grid
                RowDefinitions="*"
                ColumnDefinitions="720,*"
                ColumnSpacing="24">

            <!-- ===================================================== -->
            <!-- LEFT -->
            <!-- ===================================================== -->

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

    <TextBlock
        Grid.Row="0"
        Classes="heading"
        Text="Startup Discovery"/>

    <TextBlock
        Grid.Row="1"
        Margin="0,10,0,0"
        Classes="body"
        Text="The application automatically discovers installed DJ software and media locations."/>

        <ScrollViewer
            Grid.Row="2"
            Margin="0,15,0,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Spacing="16">

        <!-- ===================================================== -->
        <!-- Installed Providers -->
        <!-- ===================================================== -->

        <TextBlock
            Classes="section"
            Text="Installed DJ Software"/>

        <ItemsControl
            ItemsSource="{Binding InstalledProviders}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <cards:ProviderCard/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <!-- ===================================================== -->
        <!-- Media Locations -->
        <!-- ===================================================== -->

        <Border
            Classes="card"
            Padding="12">

            <StackPanel Spacing="15">

                <TextBlock
                    Classes="section"
                    Text="Media Locations"/>

                <ItemsControl
                    ItemsSource="{Binding MediaLocations}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <navigation:NavigationRow
                                Icon="📁"
                                Text="{Binding Path}"

                                LeftCommand="{Binding $parent[views:DashboardView].OpenMediaLocationCommand}"
                                LeftCommandParameter="{Binding}"

                                RightCommand="{Binding $parent[views:DashboardView].SelectMediaLocationCommand}"
                                RightCommandParameter="{Binding}" />

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </Border>

<!-- ===================================================== -->
<!-- Library Tools -->
<!-- ===================================================== -->

<Border
    Classes="card"
    Padding="12">

    <StackPanel Spacing="10">

        <TextBlock
            Classes="section"
            Text="Library Tools"/>

        <navigation:NavigationRow
            Icon="📚"
            Text="Library Explorer"/>

        <navigation:NavigationRow
            Icon="🔍"
            Text="Analysis"/>

        <navigation:NavigationRow
            Icon="🛠"
            Text="Recovery"/>

        <navigation:NavigationRow
            Icon="📊"
            Text="Reports"/>

        <navigation:NavigationRow
            Icon="⚙"
            Text="Settings"/>

    </StackPanel>

</Border>

</StackPanel>

</ScrollViewer>
</Grid>

            <!-- ===================================================== -->
            <!-- RIGHT -->
            <!-- ===================================================== -->

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Classes="card"
                Padding="20"
                VerticalAlignment="Stretch">

            <ContentControl
                Content="{Binding CurrentWorkspace}" />

            </Border>

        </Grid>

    </Border>

</UserControl>