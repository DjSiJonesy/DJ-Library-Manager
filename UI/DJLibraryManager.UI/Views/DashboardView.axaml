<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:cards="using:DJLibraryManager.UI.Controls.Cards"
    xmlns:panels="using:DJLibraryManager.UI.Controls.Panels"
    xmlns:views="using:DJLibraryManager.UI.Views"
    x:Class="DJLibraryManager.UI.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    mc:Ignorable="d">

    <Border
        Classes="card"
        Padding="25">

            <Grid
            ColumnDefinitions="720,*"
            ColumnSpacing="24">

            <!-- ===================================================== -->
            <!-- LEFT -->
            <!-- ===================================================== -->

            <Grid Grid.Column="0">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock
        Grid.Row="0"
        Classes="heading"
        Text="Startup Discovery"/>

    <TextBlock
        Grid.Row="1"
        Margin="0,10,0,0"
        Classes="body"
        Text="The application automatically discovers installed DJ software and media locations."/>

        <ScrollViewer
            Grid.Row="2"
            Margin="0,25,0,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Spacing="20">

        <!-- ===================================================== -->
        <!-- Installed Providers -->
        <!-- ===================================================== -->

        <TextBlock
            Classes="section"
            Text="Installed DJ Software"/>

        <ItemsControl
            ItemsSource="{Binding InstalledProviders}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <cards:ProviderCard/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <!-- ===================================================== -->
        <!-- Media Locations -->
        <!-- ===================================================== -->

<Border
    Classes="card"
    Padding="12">

    <StackPanel Spacing="15">

        <TextBlock
            Classes="section"
            Text="Media Locations"/>

        <ItemsControl
            ItemsSource="{Binding MediaLocations}">

            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,6"
                        Padding="6"
                        CornerRadius="6">

                        <Grid
                            ColumnDefinitions="Auto,Auto,Auto,*"
                            ColumnSpacing="8">

                            <!-- Open Folder -->

                            <Button
                                Grid.Column="0"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding $parent[views:DashboardView].OpenMediaLocationCommand}"
                                CommandParameter="{Binding}">

                                <TextBlock
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="📁"/>

                            </Button>

                            <!-- Folder Path -->

                            <TextBlock
                                Grid.Column="1"
                                Margin="4,0,4,0"
                                Classes="body"
                                VerticalAlignment="Center"
                                Text="{Binding Path}"/>

                            <!-- Navigate -->

                            <Button
                                Grid.Column="2"
                                Width="24"
                                Height="24"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Content="❯"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </StackPanel>

</Border>

        <!-- ===================================================== -->
        <!-- Library Tools -->
        <!-- ===================================================== -->

<Border
    Classes="card"
    Padding="12">

    <StackPanel Spacing="15">

        <TextBlock
            Classes="section"
            Text="Library Tools"/>

        <Grid
            ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="8">

            <TextBlock
                Grid.Column="0"
                Classes="body"
                VerticalAlignment="Center"
                Text="📚 Library Explorer"/>

               <Button
                 Grid.Column="2"
                 Width="24"
                 Height="24"
                 Padding="0"
                 Background="Transparent"
                 BorderThickness="0"
                 Cursor="Hand"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center"
                 Content="❯"/>

        </Grid>

        <Grid
            ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="8">

            <TextBlock
                Grid.Column="0"
                Classes="body"
                VerticalAlignment="Center"
                Text="🔍 Analysis"/>

                <Button
                  Grid.Column="2"
                  Width="24"
                  Height="24"
                  Padding="0"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Content="❯"/>

        </Grid>

        <Grid
            ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="8">

            <TextBlock
                Grid.Column="0"
                Classes="body"
                VerticalAlignment="Center"
                Text="🛠 Recovery"/>

                <Button
                  Grid.Column="2"
                  Width="24"
                  Height="24"
                  Padding="0"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Content="❯"/>
        </Grid>

        <Grid
            ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="8">

            <TextBlock
                Grid.Column="0"
                Classes="body"
                VerticalAlignment="Center"
                Text="📊 Reports"/>

            <Button
                Grid.Column="1"
                Width="24"
                Height="24"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="❯"/>

        </Grid>

        <Grid
            ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="8">

            <TextBlock
                Grid.Column="0"
                Classes="body"
                VerticalAlignment="Center"
                Text="⚙ Settings"/>

            <Button
                Grid.Column="1"
                Width="24"
                Height="24"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="❯"/>

        </Grid>

    </StackPanel>

</Border>

</StackPanel>

</ScrollViewer>
</Grid>

            <!-- ===================================================== -->
            <!-- RIGHT -->
            <!-- ===================================================== -->

            <Border
                Grid.Column="1"
                Classes="card"
                Padding="20">

            <ContentControl
                Content="{Binding CurrentWorkspace}" />

            </Border>

        </Grid>

    </Border>

</UserControl>