<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:local="using:DJLibraryManager.UI"
    x:Class="DJLibraryManager.UI.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d"
    Width="1005"
    Height="800"
    MinWidth="1010"
    MinHeight="750"
    Title="DJ Library Manager"
    Background="{DynamicResource Brush.Background}">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.DataTemplates>
        <local:ViewLocator/>
    </Window.DataTemplates>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Classes="display"
                Text="DJ Library Manager"/>

            <TextBlock
                Classes="subheading"
                Margin="0,4,0,0"
                Text="by SMSounds"/>

        </StackPanel>

        <!-- Main Content -->

        <ContentControl
            Grid.Row="2"
            Content="{Binding CurrentView}" />

        <!-- Footer -->

        <TextBlock
            Grid.Row="4"
            Classes="caption"
            HorizontalAlignment="Right"
            Text="{Binding StatusText}" />

    </Grid>

</Window>