<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowMediaLocationImportRow"
    x:Name="Root">

    <Border
        Padding="0"
        Margin="0,2">

        <Grid
            ColumnDefinitions="220,170,100,100,180,*"
            VerticalAlignment="Center">

            <!-- ===================================================== -->
            <!-- Main Path -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding MediaLocation.Path, ElementName=Root}" />

            <!-- ===================================================== -->
            <!-- Status -->
            <!-- ===================================================== -->

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="6">

                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{Binding MediaLocation.ImportStatusBrush,
                                   ElementName=Root}" />

                <TextBlock
                    FontSize="12"
                    Text="{Binding MediaLocation.ImportStatus,
                                   ElementName=Root}" />

            </StackPanel>

            <!-- ===================================================== -->
            <!-- Tracks -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="12"
                Text="{Binding MediaLocation.TotalMediaFiles,
                               ElementName=Root,
                               StringFormat={}{0:N0}}" />

            <!-- ===================================================== -->
            <!-- Folders -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="12"
                Text="{Binding MediaLocation.FolderCount,
                               ElementName=Root,
                               StringFormat={}{0:N0}}" />

            <!-- ===================================================== -->
            <!-- Last Imported -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="4"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Text="{Binding MediaLocation.LastImported,
                               ElementName=Root,
                               TargetNullValue=Never}" />

            <!-- ===================================================== -->
            <!-- Action -->
            <!-- ===================================================== -->

            <Button
                Grid.Column="5"
                Width="90"
                HorizontalAlignment="Center"
                Theme="{StaticResource DJLM.SmallPrimaryButton}"
                Command="{Binding ImportCommand, ElementName=Root}"
                CommandParameter="{Binding MediaLocation, ElementName=Root}"
                IsEnabled="{Binding MediaLocation.CanImport,
                                    ElementName=Root}"
                Content="{Binding MediaLocation.ImportActionText,
                                  ElementName=Root}" />

        </Grid>

    </Border>

</UserControl>