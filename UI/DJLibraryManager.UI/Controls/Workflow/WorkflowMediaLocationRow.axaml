<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowMediaLocationRow"
    x:Name="Root">

    <Border
        Padding="6"
        Margin="0,2">

        <Grid
            ColumnDefinitions="60,*,95,95,95,220"
            VerticalAlignment="Center">

            <!-- ===================================================== -->
            <!-- Drive -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="0"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Text="{Binding Drive, ElementName=Root}" />

            <!-- ===================================================== -->
            <!-- Path -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="1"
                Margin="18,0,0,0"
                FontSize="12"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Text="{Binding Path, ElementName=Root}" />

            <!-- ===================================================== -->
            <!-- Folder Count -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Text="{Binding FolderCount, ElementName=Root, StringFormat={}{0:N0}}" />

            <!-- ===================================================== -->
            <!-- Audio Count -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Text="{Binding AudioFileCount, ElementName=Root, StringFormat={}{0:N0}}" />

            <!-- ===================================================== -->
            <!-- Video Count -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Column="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Text="{Binding VideoFileCount, ElementName=Root, StringFormat={}{0:N0}}" />

            <!-- ===================================================== -->
            <!-- Status -->
            <!-- ===================================================== -->

            <StackPanel
                Grid.Column="5"
                Margin="12,0,0,0"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">

                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{Binding StatusBrush, ElementName=Root}" />

                <!-- Status text -->

                <TextBlock
                    FontSize="12"
                    VerticalAlignment="Center"
                    Text="{Binding Status, ElementName=Root}" />

                <!-- Discover -->

                <Button
                    Padding="0"
                    Margin="8,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding DiscoverCommand, ElementName=Root}"
                    CommandParameter="{Binding DiscoverCommandParameter, ElementName=Root}"
                    IsVisible="{Binding CanDiscover, ElementName=Root}">

                    <TextBlock
                        FontSize="12"
                        Text="Discover →"
                        TextDecorations="Underline"/>

                </Button>

                <!-- View -->

                <Button
                    Padding="0"
                    Margin="8,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding ViewCommand, ElementName=Root}"
                    CommandParameter="{Binding ViewCommandParameter, ElementName=Root}"
                    IsVisible="{Binding CanView, ElementName=Root}">

                    <TextBlock
                        FontSize="12"
                        Text="View →"
                        TextDecorations="Underline"/>

                </Button>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>