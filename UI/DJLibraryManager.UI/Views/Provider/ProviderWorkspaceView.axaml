<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:common="using:DJLibraryManager.UI.Controls.Common"
    x:Class="DJLibraryManager.UI.Views.ProviderWorkspaceView"
    x:DataType="vm:ProviderWorkspaceViewModel"
    mc:Ignorable="d">

    <Grid>

    <StackPanel
    Margin="0"
    MaxWidth="1200"
    HorizontalAlignment="Stretch"
    Spacing="16">

    <!-- ===================================================== -->
    <!-- Workspace Header -->
    <!-- ===================================================== -->

    <Grid
        ColumnDefinitions="*,Auto"
        RowDefinitions="Auto,Auto"
        ColumnSpacing="8">

        <!-- Heading -->

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Classes="heading"
            VerticalAlignment="Center"
            Text="{Binding ProviderName, StringFormat='{}{0} Provider'}"/>

        <!-- Description -->

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,2,0,0"
            Classes="caption"
            Text="Information about your installed DJ software, libraries and configuration."/>

    </Grid>

    <!-- ===================================================== -->
    <!-- Workspace Content -->
    <!-- ===================================================== -->

    <Grid
        ColumnDefinitions="220,*"
        ColumnSpacing="20">

        <!-- ===================================================== -->
        <!-- Provider Summary -->
        <!-- ===================================================== -->

        <Border
            Grid.Column="0"
            Classes="card-secondary"
            Padding="12">

            <StackPanel
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                Spacing="10">

                <!-- Logo -->

                <Border
                    Width="64"
                    Height="64"
                    CornerRadius="12"
                    ClipToBounds="True"
                    HorizontalAlignment="Center">

                    <Image
                        Source="{Binding ProviderLogo}"
                        Stretch="Uniform"/>

                </Border>

                <!-- Provider Name -->

                <TextBlock
                    Classes="section"
                    HorizontalAlignment="Center"
                    Text="{Binding ProviderName}"/>

                <!-- Status -->

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6">

                    <Ellipse
                        Width="10"
                        Height="10"
                        Fill="{Binding StatusBrush}"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Classes="body"
                        VerticalAlignment="Center"
                        Text="{Binding StatusText}"/>

                </StackPanel>

                <!-- Version -->

                <TextBlock
                    Classes="caption"
                    HorizontalAlignment="Center"
                    Text="{Binding Version, StringFormat='Version {0}'}"/>

                <!-- Import -->

                <Button
                    Margin="0,8,0,0"
                    Width="180"
                    MinHeight="32"
                    Padding="12,4"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Theme="{StaticResource DJLM.PrimaryButton}"
                    Command="{Binding ImportLibraryCommand}"
                    IsEnabled="{Binding Provider.CanImport}"
                    Content="📥 Import Library"/>

            </StackPanel>

        </Border>

                <!-- ===================================================== -->
                <!-- Installation -->
                <!-- ===================================================== -->

                <Border
                    Grid.Column="1"
                    Classes="card-secondary"
                    Padding="12">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Classes="section"
                            VerticalAlignment="Top"
                            Text="Installation"/>

                        <!-- ================================================= -->
                        <!-- Executable -->
                        <!-- ================================================= -->

                            <Button
                                Theme="{StaticResource DJLM.SecondaryButton}"
                                MinHeight="40"
                                Padding="12,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Command="{Binding OpenInstallationFolderCommand}">

                                <Grid
                                    ColumnDefinitions="28,95,*"
                                    ColumnSpacing="12"
                                    Margin="0,2">

                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="14"
                                        VerticalAlignment="Center"
                                        Text="💻"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="subheading"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Text="Executable"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Text="{Binding ExecutablePath}"
                                        TextTrimming="CharacterEllipsis"/>

                                </Grid>

                            </Button>

                        <!-- ================================================= -->
                        <!-- Database -->
                        <!-- ================================================= -->

                            <Button
                                Theme="{StaticResource DJLM.SecondaryButton}"
                                MinHeight="40"
                                Padding="12,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Command="{Binding OpenDatabaseFolderCommand}">

                                <Grid
                                    ColumnDefinitions="28,95,*"
                                    ColumnSpacing="12"
                                    Margin="0,2">

                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="14"
                                        VerticalAlignment="Center"
                                        Text="🗄️"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="subheading"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Text="Database"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Text="{Binding DatabasePath}"
                                        TextTrimming="CharacterEllipsis"/>

                                </Grid>

                            </Button>

                        <!-- ================================================= -->
                        <!-- Settings -->
                        <!-- ================================================= -->

                            <Button
                                Theme="{StaticResource DJLM.SecondaryButton}"
                                MinHeight="40"
                                Padding="12,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Command="{Binding OpenSettingsFolderCommand}">

                                <Grid
                                    ColumnDefinitions="28,95,*"
                                    ColumnSpacing="12"
                                    Margin="0,2">

                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="14"
                                        VerticalAlignment="Center"
                                        Text="⚙️"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="subheading"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Text="Settings"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Text="{Binding SettingsPath}"
                                        TextTrimming="CharacterEllipsis"/>

                                </Grid>

                            </Button>

                    </StackPanel>

                </Border>
            </Grid>

                <!-- ===================================================== -->
                <!-- Library -->
                <!-- ===================================================== -->

                <Border
                    Classes="card-secondary"
                    Padding="12">

                    <StackPanel
                        Spacing="12">

                        <!-- ================================================= -->
                        <!-- Heading -->
                        <!-- ================================================= -->

                        <TextBlock
                            Classes="section"
                            VerticalAlignment="Top"
                            Text="Library"/>

                        <!-- ================================================= -->
                        <!-- Import Progress -->
                        <!-- ================================================= -->

                        <Border
                            Classes="card"
                            Padding="12"
                            IsVisible="{Binding CurrentOperation.IsRunning}">

                            <StackPanel
                                Spacing="8">

                                <TextBlock
                                    Classes="section"
                                    Text="Import Progress"/>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    Text="{Binding CurrentOperation.OperationName}"/>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Text="{Binding CurrentOperation.CurrentStage}"/>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Classes="caption"
                                    Text="{Binding CurrentOperation.CurrentItem}"/>

                                <ProgressBar
                                    Height="8"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding CurrentOperation.Percentage}"
                                    Foreground="{StaticResource Brush.Brand.Gradient}"
                                    IsIndeterminate="{Binding CurrentOperation.IsIndeterminate}"/>

                                <Grid
                                    ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        FontSize="12"
                                        Text="{Binding CurrentOperation.CurrentValue}"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="{Binding CurrentOperation.Percentage, StringFormat='{}{0:F0}%'}"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <!-- ================================================= -->
                        <!-- Library Information -->
                        <!-- ================================================= -->

                        <StackPanel
                            Spacing="4">

                            <!-- Status -->

                            <Grid
                                ColumnDefinitions="28,95,*"
                                ColumnSpacing="12"
                                Margin="0,2">

                                <Ellipse
                                    Width="14"
                                    Height="14"
                                    Fill="{Binding Provider.LibraryStatusBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Classes="subheading"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Text="Status"/>

                                <TextBlock
                                    Grid.Column="2"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Text="{Binding Provider.LibraryStatus}"/>

                            </Grid>

                            <common:PropertyRow
                                Icon="📅"
                                Label="Last Imported"
                                Value="{Binding Provider.LastImported}"/>

                            <common:PropertyRow
                                Icon="🎵"
                                Label="Tracks"
                                Value="{Binding Provider.TrackCount, StringFormat={}{0:N0}}"/>

                            <common:PropertyRow
                                Icon="📂"
                                Label="Playlists"
                                Value="{Binding Provider.PlaylistCount, StringFormat={}{0:N0}}"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

       </StackPanel>

    </Grid>

</UserControl>