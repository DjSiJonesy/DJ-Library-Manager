<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DJLibraryManager.UI.Models"
    x:Class="DJLibraryManager.UI.Controls.Cards.ProviderCard"
    x:DataType="models:ProviderInfo"
    mc:Ignorable="d">

    <UserControl.Styles>

        <Style Selector="Border.card">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.Panel}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Panel.Border}" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>

    </UserControl.Styles>

    <Button
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        Padding="0"
        Cursor="{Binding CardCursor}"
        Command="{Binding OpenCommand}"
        CommandParameter="{Binding Name}">

        <Button.Template>

            <ControlTemplate>

                <ContentPresenter
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Content="{TemplateBinding Content}" />

            </ControlTemplate>

        </Button.Template>

        <Border
            x:Name="CardBorder"
            Classes="card"
            Width="125"
            Height="125"
            Margin="0,0,12,12"
            Opacity="{Binding CardOpacity}"
            PointerEntered="CardBorder_PointerEntered"
            PointerExited="CardBorder_PointerExited">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="4">

                <!-- Provider Logo -->

                <Border
                    Width="56"
                    Height="56"
                    CornerRadius="8"
                    ClipToBounds="True"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">

                    <Image
                        Stretch="Uniform"
                        Source="{Binding ProviderLogo}" />

                </Border>

                <!-- Provider Name -->

                <TextBlock
                    Classes="providerName"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Text="{Binding Name}" />

                <!-- Provider Status -->

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6">

                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{Binding StatusBrush}"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Classes="providerStatus"
                        VerticalAlignment="Center"
                        Text="{Binding Status}" />

                </StackPanel>

            </StackPanel>

        </Border>

    </Button>

</UserControl>