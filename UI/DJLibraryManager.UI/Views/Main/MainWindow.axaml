<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:local="using:DJLibraryManager.UI"
    x:Class="DJLibraryManager.UI.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d"
    Width="1005"
    Height="800"
    MinWidth="1010"
    MinHeight="750"
    Title="DIASISS DJ Library Manager"
    Background="{DynamicResource Brush.Background}">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.DataTemplates>
        <local:ViewLocator/>
    </Window.DataTemplates>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- Header -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="20">

            <!-- ================================================= -->
            <!-- Application Logo -->
            <!-- ================================================= -->

            <Border
                Grid.Column="0"
                Height="90"
                VerticalAlignment="Center"
                HorizontalAlignment="Left">

                <Image
                    Source="avares://DJLibraryManager.UI/Assets/Logos/DIASISS_Logo.png"
                    Stretch="Uniform"/>

            </Border>

            <!-- ================================================= -->
            <!-- User / Licence Information -->
            <!-- ================================================= -->

            <Border
                Grid.Column="2"
                Padding="18,12"
                VerticalAlignment="Center"
                CornerRadius="10"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">

                <StackPanel
                    HorizontalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Guest User"/>

                    <TextBlock
                        Margin="0,4,0,0"
                        Classes="caption"
                        HorizontalAlignment="Center"
                        Text="Community Edition"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ===================================================== -->
        <!-- Main Content -->
        <!-- ===================================================== -->

        <ContentControl
            Grid.Row="2"
            Content="{Binding Dashboard}" />

        <!-- ===================================================== -->
        <!-- Footer -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="4"
            Margin="0,2,0,0"
            ColumnDefinitions="*,Auto">

            <!-- ================================================= -->
            <!-- SMSounds Branding -->
            <!-- ================================================= -->

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">

                <TextBlock
                    Classes="caption"
                    VerticalAlignment="Center"
                    Text="©"/>

                <Image
                    Source="avares://DJLibraryManager.UI/Assets/Logos/SMSounds_Wordmark.png"
                    Height="8"
                    VerticalAlignment="Center"
                    Stretch="Uniform"/>

            </StackPanel>

            <!-- ================================================= -->
            <!-- Application Status -->
            <!-- ================================================= -->

            <TextBlock
                Grid.Column="1"
                Classes="caption"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Text="{Binding StatusText}" />

        </Grid>

    </Grid>

</Window>