<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:cards="using:DJLibraryManager.UI.Controls.Cards"
    xmlns:panels="using:DJLibraryManager.UI.Controls.Panels"
    xmlns:navigation="using:DJLibraryManager.UI.Controls.Navigation"
    xmlns:views="using:DJLibraryManager.UI.Views"
    x:Class="DJLibraryManager.UI.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    mc:Ignorable="d">

    <Border
        Classes="card"
        Padding="25">
        

            <Grid
                RowDefinitions="*"
                ColumnDefinitions="720,*"
                ColumnSpacing="24">

    <!-- ===================================================== -->
    <!-- LEFT -->
    <!-- ===================================================== -->

<Grid
    Grid.Row="0"
    Grid.Column="0"
    RowDefinitions="Auto,Auto,*,12,Auto"
    VerticalAlignment="Stretch">

    <!-- ===================================================== -->
    <!-- Startup -->
    <!-- ===================================================== -->

    <StackPanel
        Grid.Row="0">

        <TextBlock
            Classes="heading"
            Text="Startup Discovery"/>

        <TextBlock
            Margin="0,10,0,0"
            Classes="body"
            Text="The application automatically discovers installed DJ software and media locations."/>

    </StackPanel>

    <!-- ===================================================== -->
    <!-- Installed Providers -->
    <!-- ===================================================== -->

    <StackPanel
        Grid.Row="1"
        Margin="0,20,0,0"
        Spacing="15">

        <TextBlock
            Classes="section"
            Text="Installed DJ Software"/>

        <ItemsControl
            ItemsSource="{Binding InstalledProviders}">

            <ItemsControl.ItemsPanel>

                <ItemsPanelTemplate>

                    <WrapPanel Orientation="Horizontal"/>

                </ItemsPanelTemplate>

            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <cards:ProviderCard/>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </StackPanel>

    <Border
    Grid.Row="2"
    Classes="card"
    Padding="12">

    <Grid
        RowDefinitions="Auto,*"
        RowSpacing="12">

        <TextBlock
            Grid.Row="0"
            Classes="section"
            Text="Media Locations"/>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <ItemsControl
                ItemsSource="{Binding MediaLocations}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <navigation:NavigationRow
                            Icon="📁"
                            Text="{Binding Path}"

                            LeftCommand="{Binding $parent[views:DashboardView].OpenMediaLocationCommand}"
                            LeftCommandParameter="{Binding}"

                            RightCommand="{Binding $parent[views:DashboardView].SelectMediaLocationCommand}"
                            RightCommandParameter="{Binding}" />

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Border>

    <Border Grid.Row="3"/>

    <Border
    Grid.Row="4"
    Classes="card"
    Padding="12">

    <StackPanel
        Spacing="0">

        <TextBlock
            Classes="section"
            Text="Library Tools"/>

        <navigation:NavigationRow
            Icon="🗂️"
            Text="Library Explorer"/>

        <navigation:NavigationRow
            Icon="🔄"
            Text="Analysis"/>

        <navigation:NavigationRow
            Icon="🛠"
            Text="Recovery"/>

        <navigation:NavigationRow
            Icon="📊"
            Text="Reports"/>

        <navigation:NavigationRow
            Icon="⚙"
            Text="Settings"/>

    </StackPanel>

</Border>

</Grid>

            <!-- ===================================================== -->
            <!-- RIGHT -->
            <!-- ===================================================== -->

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Classes="card"
                Padding="20"
                VerticalAlignment="Stretch">

            <ContentControl
                Content="{Binding CurrentWorkspace}" />

            </Border>

        </Grid>

    </Border>

</UserControl>