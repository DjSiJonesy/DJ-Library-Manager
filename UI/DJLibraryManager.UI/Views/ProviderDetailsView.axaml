<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:common="using:DJLibraryManager.UI.Controls.Common"
    x:Class="DJLibraryManager.UI.Views.ProviderDetailsView"
    x:DataType="vm:ProviderDetailsViewModel"
    mc:Ignorable="d">

    <ScrollViewer>

        <Grid>

            <StackPanel
                Margin="30"
                MaxWidth="1000"
                HorizontalAlignment="Center"
                Spacing="24">

                <!-- Back -->

                <Button
                    HorizontalAlignment="Left"
                    Command="{Binding GoBackCommand}"
                    Content="← Dashboard"/>

                <!-- Provider -->

                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8">

                    <Border
                        Width="96"
                        Height="96"
                        CornerRadius="16"
                        ClipToBounds="True"
                        HorizontalAlignment="Center">

                        <Image
                            Source="{Binding ProviderLogo}"
                            Stretch="Uniform"/>
                    </Border>

                    <TextBlock
                        Classes="heading"
                        HorizontalAlignment="Center"
                        Text="{Binding ProviderName}"/>

                    <TextBlock
                        Classes="body"
                        HorizontalAlignment="Center"
                        Text="{Binding InstalledText}"/>

                    <TextBlock
                        Classes="caption"
                        HorizontalAlignment="Center"
                        Text="{Binding Version, StringFormat='Version {0}'}"/>

                </StackPanel>

                <!-- Installation -->

                <Border Classes="card">

                    <StackPanel Spacing="18">

                        <TextBlock
                            Classes="section"
                            Text="Installation"/>

                        <common:PropertyRow
                            Icon="📄"
                            Label="Executable"
                            Value="{Binding ExecutablePath}"/>

                        <common:PropertyRow
                            Icon="🗄️"
                            Label="Database"
                            Value="{Binding DatabasePath}"/>

                        <common:PropertyRow
                            Icon="⚙️"
                            Label="Settings"
                            Value="{Binding SettingsPath}"/>

                    </StackPanel>

                </Border>

                <!-- Actions -->

                <Border Classes="card">

                    <StackPanel Spacing="18">

                        <TextBlock
                            Classes="section"
                            Text="Actions"/>

                        <Button
                            Theme="{StaticResource DJLM.PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Content="🔍 Analyse Library"/>

                        <Button
                            Theme="{StaticResource DJLM.SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenInstallationFolderCommand}"
                            Content="💻 Open Installation Folder"/>

                        <Button
                            Theme="{StaticResource DJLM.SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenDatabaseFolderCommand}"
                            Content="📂 Open Database Folder"/>

                        <Button
                            Theme="{StaticResource DJLM.SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenSettingsFolderCommand}"
                            Content="⚙️ Open Settings Folder"/>
                                                
                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>