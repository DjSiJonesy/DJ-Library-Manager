<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DJLibraryManager.UI.Models.Search"
    xmlns:searchModels="using:DJLibraryManager.UI.Search.Models"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowSearchResults"
    x:Name="Root">

    <Border
        Classes="card-secondary"
        Padding="12">

        <Grid
            RowDefinitions="Auto,12,*">

            <!-- ================================================= -->
            <!-- Heading -->
            <!-- ================================================= -->

            <TextBlock
                Grid.Row="0"
                Classes="subheading"
                Text="{Binding Heading,
                               ElementName=Root}" />

            <!-- ================================================= -->
            <!-- DUPLICATE RESULTS -->
            <!-- ================================================= -->

            <ListBox
                Grid.Row="2"
                ItemsSource="{Binding Results,
                                      ElementName=Root}"
                IsVisible="{Binding IsDuplicateResults,
                                    ElementName=Root}"
                ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate
                        x:DataType="models:SearchResult">

                        <Border
                            Padding="10"
                            Margin="0,4"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6">

                            <Grid
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                                <!-- Track -->

                                <Grid
                                    Grid.Row="0"
                                    ColumnDefinitions="*,Auto">

                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="2">

                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding TrackTitle,
                                                           TargetNullValue=Unknown Track}" />

                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding Artist,
                                                           TargetNullValue=Unknown Artist}" />

                                        <TextBlock
                                            Classes="caption"
                                            Text="{Binding Album,
                                                           TargetNullValue=No Album}" />

                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Text="{Binding MatchScore,
                                                       StringFormat={}{0:F1}%}" />

                                </Grid>

                                <!-- Music Information -->

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    ColumnDefinitions="*,*,*">

                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="2">

                                        <TextBlock
                                            Classes="caption"
                                            Text="BPM" />

                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding Bpm,
                                                           StringFormat={}{0:F0}}" />

                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="2">

                                        <TextBlock
                                            Classes="caption"
                                            Text="Key" />

                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding Key,
                                                           TargetNullValue=—}" />

                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Spacing="2">

                                        <TextBlock
                                            Classes="caption"
                                            Text="Duration" />

                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding Duration,
                                                           StringFormat={}{0:mm\\:ss}}" />

                                    </StackPanel>

                                </Grid>

                                <!-- File -->

                                <StackPanel
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    Spacing="2">

                                    <TextBlock
                                        Classes="caption"
                                        Text="{Binding FilePath}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Classes="caption"
                                        Text="{Binding FileSize,
                                                       StringFormat=Size: {0:N0} bytes}" />

                                </StackPanel>

                                <!-- Recommendation -->

                                <StackPanel
                                    Grid.Row="3"
                                    Margin="0,8,0,0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding Source}" />

                                    <TextBlock
                                        Classes="caption"
                                        Text="{Binding RecommendationReason}"
                                        TextWrapping="Wrap" />

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        IsVisible="{Binding IsRecommended}">

                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            VerticalAlignment="Center"
                                            Fill="LimeGreen" />

                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="LimeGreen"
                                            Text="RECOMMENDED" />

                                    </StackPanel>

                                </StackPanel>

                                <!-- Keep Selection -->

                                <Button
                                    Grid.Row="4"
                                    Margin="0,10,0,0"
                                    HorizontalContentAlignment="Left"
                                    Click="KeepResult_Click">

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">

                                        <TextBlock
                                            FontSize="14"
                                            Text="☑"
                                            IsVisible="{Binding IsSelected}" />

                                        <TextBlock
                                            FontSize="14"
                                            Text="☐"
                                            IsVisible="{Binding !IsSelected}" />

                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="KEEP THIS COPY" />

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

            <!-- ================================================= -->
            <!-- METADATA RESULTS -->
            <!-- ================================================= -->

            <ScrollViewer
                Grid.Row="2"
                IsVisible="{Binding IsMetadataResults,
                                    ElementName=Root}"
                VerticalScrollBarVisibility="Auto">

                <StackPanel
                    Spacing="16">

                    <!-- ========================================= -->
                    <!-- File Identity -->
                    <!-- ========================================= -->

                    <Border
                        Padding="12"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6">

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{Binding MetadataDisplayName,
                                               ElementName=Root}" />

                            <TextBlock
                                Classes="caption"
                                Text="{Binding MetadataFilePath,
                                               ElementName=Root}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                    <!-- ========================================= -->
                    <!-- Existing Metadata -->
                    <!-- ========================================= -->

                    <Border
                        Padding="12"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6">

                        <StackPanel
                            Spacing="10">

                            <TextBlock
                                Classes="subheading"
                                Text="Current Metadata" />

                            <Grid
                                ColumnDefinitions="Auto,*"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                ColumnSpacing="16"
                                RowSpacing="6">

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Classes="caption"
                                    Text="Artist" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding MetadataArtist,
                                                   ElementName=Root,
                                                   TargetNullValue=—}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Classes="caption"
                                    Text="Title" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding MetadataTitle,
                                                   ElementName=Root,
                                                   TargetNullValue=—}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Classes="caption"
                                    Text="Album" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding MetadataAlbum,
                                                   ElementName=Root,
                                                   TargetNullValue=—}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Classes="caption"
                                    Text="Genre" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{Binding MetadataGenre,
                                                   ElementName=Root,
                                                   TargetNullValue=—}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Classes="caption"
                                    Text="Year" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="{Binding MetadataYear,
                                                   ElementName=Root,
                                                   TargetNullValue=—}" />

                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Classes="caption"
                                    Text="BPM" />

                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Text="{Binding MetadataBpm,
                                                   ElementName=Root,
                                                   TargetNullValue=—}" />

                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Classes="caption"
                                    Text="Key" />

                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Text="{Binding MetadataKey,
                                                   ElementName=Root,
                                                   TargetNullValue=—}" />

                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Classes="caption"
                                    Text="Duration" />

                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Text="{Binding MetadataDuration,
                                                   ElementName=Root,
                                                   TargetNullValue=—}" />

                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- ========================================= -->
                    <!-- Recommended Changes -->
                    <!-- ========================================= -->

                    <Border
                        Padding="12"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6">

                        <StackPanel
                            Spacing="10">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">

                                <TextBlock
                                    Grid.Column="0"
                                    Classes="subheading"
                                    Text="Recommended Changes" />

                                <Button
                                    Grid.Column="1"
                                    Theme="{StaticResource DJLM.SecondaryButton}"
                                    Padding="8,4"
                                    Content="↔ Swap Artist / Title"
                                    Click="SwapArtistTitle_Click"
                                    IsVisible="{Binding IsMetadataResults,
                                                        ElementName=Root}"
                                    IsEnabled="{Binding HasConfirmableMetadataChanges,
                                                        ElementName=Root}" />

                            </Grid>

                            <TextBlock
                                Classes="caption"
                                Text="Select the individual metadata changes you want DIASISS to prepare for confirmation." />

                            <ItemsControl
                                ItemsSource="{Binding MetadataRecommendations,
                                                      ElementName=Root}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate
                                        x:DataType="searchModels:MetadataChangeRecommendation">

                                        <Border
                                            Padding="10"
                                            Margin="0,3"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="6">

                                            <Grid
                                                ColumnDefinitions="Auto,*,Auto"
                                                ColumnSpacing="10">

                                                <!-- Checkbox -->

                                                <CheckBox
                                                    Grid.Column="0"
                                                    VerticalAlignment="Top"
                                                    IsChecked="{Binding IsSelected}"
                                                    Click="MetadataRecommendation_Click" />

                                                <!-- Change -->

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">

                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Field}" />

                                                    <TextBlock
                                                        FontSize="12">

                                                        <Run
                                                            Text="{Binding CurrentValue,
                                                                           TargetNullValue=—}" />

                                                        <Run
                                                            Text=" → " />

                                                        <Run
                                                            FontWeight="SemiBold"
                                                            Text="{Binding RecommendedValue}" />

                                                    </TextBlock>

                                                    <TextBlock
                                                        Classes="caption"
                                                        Text="{Binding Reason}"
                                                        TextWrapping="Wrap" />

                                                </StackPanel>

                                                <!-- Confidence -->

                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    Spacing="2">

                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Right"
                                                        Text="{Binding AgreementPercentage,
                                                                       StringFormat={}{0:F1}%}" />

                                                    <TextBlock
                                                        Classes="caption"
                                                        HorizontalAlignment="Right"
                                                        Text="{Binding SupportingProviders,
                                                                       StringFormat={}{0} provider(s)}" />

                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ================================================= -->
            <!-- MISSING FILE RESULTS -->
            <!-- ================================================= -->

            <ScrollViewer
                Grid.Row="2"
                IsVisible="{Binding IsMissingFileResults,
                                    ElementName=Root}"
                VerticalScrollBarVisibility="Auto">

                <StackPanel
                    Spacing="16">

                    <Border
                        Padding="16"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6">

                        <StackPanel
                            Spacing="16">

                            <TextBlock
                                Classes="subheading"
                                Text="Missing File" />

                            <StackPanel
                                Spacing="5">

                                <TextBlock
                                    Classes="caption"
                                    Text="Track" />

                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding MissingFileDisplayName,
                                                   ElementName=Root}"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                            <StackPanel
                                Spacing="5">

                                <TextBlock
                                    Classes="caption"
                                    Text="Last Known Location" />

                                <Border
                                    Padding="10"
                                    Background="{DynamicResource Brush.Background}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4">

                                    <TextBlock
                                        FontSize="12"
                                        Text="{Binding MissingFilePath,
                                                       ElementName=Root}"
                                        TextWrapping="Wrap" />

                                </Border>

                            </StackPanel>

                            <StackPanel
                                Spacing="5">

                                <TextBlock
                                    Classes="caption"
                                    Text="Status" />

                                <TextBlock
                                    FontSize="13"
                                    Text="File not found at the recorded location."
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</UserControl>