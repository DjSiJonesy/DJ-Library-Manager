<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels.Search"
    xmlns:models="using:DJLibraryManager.UI.Models.Search"
    xmlns:workflow="using:DJLibraryManager.UI.Controls.Workflow"
    xmlns:converters="using:DJLibraryManager.UI.Converters"
    x:Class="DJLibraryManager.UI.Views.Search.SearchWorkspaceView"
    x:DataType="vm:SearchWorkspaceViewModel">

    <UserControl.Resources>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,20,*">

        <workflow:WorkflowHeader
            x:Name="SearchHeader"
            Grid.Row="0"
            Title="Search"
            Description="Find information and potential solutions for issues identified during library analysis."
            ShowDuplicateProtection="True"
            PreviousText="← Analysis"
            PreviousCommand="{Binding PreviousCommand}"
            NextText="Improve →"
            NextCommand="{Binding NextCommand}"/>

        <Grid Grid.Row="2" RowDefinitions="Auto,20,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">

                <ItemsControl Grid.Column="0" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchCategoryInfo">
                            <Button
                                Theme="{StaticResource DJLM.PrimaryButton}"
                                Padding="12,8"
                                MinWidth="170"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectCategoryCommand}"
                                CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding Icon}"/>
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding IssueCount, StringFormat={}{0:N0}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button
                    Grid.Column="1"
                    Theme="{StaticResource DJLM.SecondaryButton}"
                    Padding="12,8"
                    MinHeight="46"
                    VerticalAlignment="Center"
                    Content="📁 Open DIASISS Duplicates →"
                    Command="{Binding OpenDuplicatesCommand, ElementName=SearchHeader}"/>
            </Grid>

            <Grid Grid.Row="2" RowDefinitions="Auto,20,*">

                <Border Grid.Row="0" Classes="card-secondary" Padding="12">
                    <Grid ColumnDefinitions="*,Auto">

                        <StackPanel Spacing="5">

                            <TextBlock
                                Classes="subheading"
                                Text="{Binding SelectedCategory.Name, TargetNullValue=Search}"/>

                            <TextBlock
                                Classes="caption"
                                Text="{Binding SelectedCategory.Description, TargetNullValue=Select a Search category.}"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Margin="0,6,0,0"
                                Classes="caption"
                                Text="{Binding SearchStatus}"/>

                            <!-- Duplicates Search All Progress -->
                            <StackPanel
                                Spacing="5"
                                IsVisible="{Binding IsDuplicateCategory}">

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="Progress"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="{Binding DuplicateSearchProgress, StringFormat={}{0:F0}%}"/>
                                </Grid>

                                <ProgressBar
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding DuplicateSearchProgress}"
                                    Foreground="{StaticResource Brush.Brand.Gradient}"/>

                                <TextBlock
                                    FontSize="11"
                                    Classes="caption"
                                    Text="{Binding DuplicateSearchProgressText}"
                                    TextTrimming="CharacterEllipsis"
                                    IsVisible="{Binding ShowDuplicateSearchProgress}"/>

                            </StackPanel>

                            <!-- Metadata Search All Progress -->
                            <StackPanel
                                Spacing="5"
                                IsVisible="{Binding IsMetadataCategory}">

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="Progress"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="{Binding MetadataSearchProgress, StringFormat={}{0:F0}%}"/>
                                </Grid>

                                <ProgressBar
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding MetadataSearchProgress}"
                                    Foreground="{StaticResource Brush.Brand.Gradient}"/>

                                <TextBlock
                                    FontSize="11"
                                    Classes="caption"
                                    Text="{Binding MetadataSearchProgressText}"
                                    TextTrimming="CharacterEllipsis"
                                    IsVisible="{Binding ShowMetadataSearchProgress}"/>

                            </StackPanel>

                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                            <Button
                                Theme="{StaticResource DJLM.PrimaryButton}"
                                Content="Search"
                                Command="{Binding SearchIssueCommand}"
                                CommandParameter="{Binding SelectedIssue}"
                                IsEnabled="{Binding !IsSearching}"/>

                            <Button
                                Theme="{StaticResource DJLM.PrimaryButton}"
                                Content="Search All"
                                Command="{Binding SearchAllCommand}"
                                CommandParameter="{Binding SelectedCategory}"
                                IsEnabled="{Binding SelectedCategory.IsSearchEnabled}"/>

                        </StackPanel>

                    </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="*,20,*">

                    <Border Grid.Column="0" Classes="card-secondary" Padding="12">
                        <Grid RowDefinitions="Auto,8,Auto,12,*">

                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                                <TextBlock Grid.Column="0" Classes="subheading">
                                    <Run Text="Issues — "/>
                                    <Run Text="{Binding SelectedCategory.Name, TargetNullValue=Search}"/>
                                </TextBlock>

                                <!-- Duplicates: independent Select All Recommended control -->
                                <Button
                                    Grid.Column="1"
                                    Theme="{StaticResource DJLM.SecondaryButton}"
                                    Padding="8,4"
                                    Command="{Binding SelectAllRecommendedCommand}"
                                    IsVisible="{Binding IsDuplicateCategory}"
                                    IsEnabled="{Binding !IsSearching}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" VerticalAlignment="Center" Text="☑" IsVisible="{Binding AllRecommendedSelected}"/>
                                        <TextBlock FontSize="14" VerticalAlignment="Center" Text="☐" IsVisible="{Binding !AllRecommendedSelected}"/>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Text="Select All Recommended"/>
                                    </StackPanel>
                                </Button>

                                <!-- Metadata: independent Select All Recommended control -->
                                <Button
                                    Grid.Column="1"
                                    Theme="{StaticResource DJLM.SecondaryButton}"
                                    Padding="8,4"
                                    Command="{Binding SelectAllRecommendedMetadataOnlyCommand}"
                                    IsVisible="{Binding IsMetadataCategory}"
                                    IsEnabled="{Binding !IsSearching}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" VerticalAlignment="Center" Text="☑" IsVisible="{Binding AllRecommendedSelected}"/>
                                        <TextBlock FontSize="14" VerticalAlignment="Center" Text="☐" IsVisible="{Binding !AllRecommendedSelected}"/>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Text="Select All Recommended"/>
                                    </StackPanel>
                                </Button>

                            </Grid>

                            <TextBox
                                Grid.Row="2"
                                PlaceholderText="Search issues..."
                                Text="{Binding IssueSearchText, UpdateSourceTrigger=PropertyChanged}"
                                Padding="8,6"
                                HorizontalContentAlignment="Stretch"/>

                            <ListBox
                                Grid.Row="4"
                                ItemsSource="{Binding FilteredIssues}"
                                SelectedItem="{Binding SelectedIssue}">

                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:SearchIssue">
                                        <Border Padding="4" Margin="0" CornerRadius="5">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis"/>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    FontSize="11"
                                                    Margin="8,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    Text="✓"
                                                    IsVisible="{Binding IsSearched}"/>

                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Classes="caption"
                                                    Text="{Binding CopyCount, StringFormat={}{0:N0} copies found}"
                                                    IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DuplicateTrack}"/>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <workflow:WorkflowSearchResults
                            Heading="{Binding SelectedCategory.Name}"
                            ResultType="{Binding SelectedCategory.Name}"
                            Issue="{Binding SelectedIssue}"
                            Results="{Binding SelectedIssue.Results}"
                            ResultSelected="WorkflowSearchResults_ResultSelected"/>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
