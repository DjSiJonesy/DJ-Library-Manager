<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DJLibraryManager.UI.Controls.Navigation.NavigationRow"
    x:Name="Root">

    <Border
        Height="30"
        Padding="4,2"
        CornerRadius="6">

        <Grid
            ColumnDefinitions="30,*,30"
            ColumnSpacing="8"
            VerticalAlignment="Center">

            <!-- ===================================================== -->
            <!-- Left Icon -->
            <!-- ===================================================== -->

            <Button
                Grid.Column="0"
                Width="30"
                Height="30"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding LeftCommand, ElementName=Root}"
                CommandParameter="{Binding LeftCommandParameter, ElementName=Root}">

                <TextBlock
                    FontSize="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{Binding Icon, ElementName=Root}"/>

            </Button>

            <!-- ===================================================== -->
            <!-- Description -->
            <!-- ===================================================== -->

            <Button
                Grid.Column="1"
                Height="30"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                Command="{Binding LeftCommand, ElementName=Root}"
                CommandParameter="{Binding LeftCommandParameter, ElementName=Root}">

                <TextBlock
                    Classes="body"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Text="{Binding Text, ElementName=Root}"
                    TextTrimming="CharacterEllipsis"/>

            </Button>

            <!-- ===================================================== -->
            <!-- Navigate -->
            <!-- ===================================================== -->

            <Button
                Grid.Column="2"
                Width="30"
                Height="30"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding RightCommand, ElementName=Root}"
                CommandParameter="{Binding RightCommandParameter, ElementName=Root}">

                <TextBlock
                    FontSize="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="➡️"/>

            </Button>

        </Grid>

    </Border>

</UserControl>