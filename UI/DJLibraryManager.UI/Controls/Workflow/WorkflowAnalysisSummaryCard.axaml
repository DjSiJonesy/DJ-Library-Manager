<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowAnalysisSummaryCard"
    x:Name="Root">

    <Border
        Classes="card-secondary"
        Padding="12">

        <Grid
            RowDefinitions="Auto,10,Auto,10,Auto,10,Auto">

            <!-- ===================================================== -->
            <!-- Heading -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Row="0"
                Classes="subheading"
                Text="Analysis Summary"/>

            <!-- ===================================================== -->
            <!-- Summary Information -->
            <!-- ===================================================== -->

            <Grid
                Grid.Row="2"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="4">

                <!-- ================================================= -->
                <!-- Tracks Scanned -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto">

                    <TextBlock
                        FontSize="12"
                        Text="Tracks Scanned"/>

                    <TextBlock
                        Grid.Column="1"
                        FontSize="12">

                        <Run
                            Text="{Binding TracksScanned,
                                           ElementName=Root,
                                           StringFormat={}{0:N0}}"/>

                        <Run Text=" / "/>

                        <Run
                            Text="{Binding TotalTracks,
                                           ElementName=Root,
                                           StringFormat={}{0:N0}}"/>

                    </TextBlock>

                </Grid>

                <!-- ================================================= -->
                <!-- Issues -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,Auto">

                    <TextBlock
                        FontSize="12"
                        Text="Issues Found"/>

                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        Text="{Binding IssuesFound,
                                       ElementName=Root,
                                       StringFormat={}{0:N0}}"/>

                </Grid>

                <!-- ================================================= -->
                <!-- Health -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="*,Auto">

                    <TextBlock
                        FontSize="12"
                        Text="Overall Health"/>

                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        Text="{Binding HealthScore,
                                       ElementName=Root,
                                       StringFormat={}{0:F1}%}"/>

                </Grid>

                <!-- ================================================= -->
                <!-- Last Analysed -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="3"
                    ColumnDefinitions="*,Auto">

                    <TextBlock
                        FontSize="12"
                        Text="Last Analysed"/>

                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        Text="{Binding LastAnalysed,
                                       ElementName=Root,
                                       TargetNullValue=Never,
                                       StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"/>

                </Grid>

            </Grid>

            <!-- ===================================================== -->
            <!-- Progress -->
            <!-- ===================================================== -->

            <StackPanel
                Grid.Row="4"
                Spacing="5">

                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="Progress"/>

                <ProgressBar
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding Progress,
                                    ElementName=Root}"
                    Foreground="{StaticResource Brush.Brand.Gradient}"/>

            </StackPanel>

            <!-- ===================================================== -->
            <!-- Status / Current Track / Action -->
            <!-- ===================================================== -->

            <Grid
                Grid.Row="6"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="20">

                <!-- ================================================= -->
                <!-- Status Information -->
                <!-- ================================================= -->

                <Grid
                    Grid.Column="0"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="5">

                    <!-- Status -->

                    <StackPanel
                        Grid.Row="0"
                        Spacing="4">

                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Status"/>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">

                            <Ellipse
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="{Binding StatusBrush,
                                               ElementName=Root}"/>

                            <TextBlock
                                FontSize="12"
                                VerticalAlignment="Center"
                                Text="{Binding Status,
                                               ElementName=Root}"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- Current Track -->

                    <StackPanel
                        Grid.Row="1"
                        Spacing="2">

                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Current Track"/>

                        <TextBlock
                            FontSize="12"
                            Text="{Binding CurrentTrack,
                                           ElementName=Root}"
                            TextTrimming="CharacterEllipsis"/>

                    </StackPanel>

                </Grid>

                <!-- ================================================= -->
                <!-- Analyse Button -->
                <!-- ================================================= -->

                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Theme="{StaticResource DJLM.PrimaryButton}"
                    Content="Analyse Library"
                    Command="{Binding AnalyseCommand,
                                      ElementName=Root}"/>

            </Grid>

        </Grid>

    </Border>

</UserControl>