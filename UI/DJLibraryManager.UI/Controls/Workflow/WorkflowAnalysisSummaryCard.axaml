<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowAnalysisSummaryCard"
    x:Name="Root">

    <Border
        Classes="card-secondary"
        Padding="12">

        <Grid
            RowDefinitions="
                Auto,
                12,
                Auto,
                Auto,
                Auto,
                Auto,
                16,
                Auto,
                12,
                Auto,
                12,
                Auto,
                16,
                Auto">

            <!-- ===================================================== -->
            <!-- Heading -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Row="0"
                Classes="subheading"
                Text="Analysis Summary"/>

            <!-- ===================================================== -->
            <!-- Tracks Scanned -->
            <!-- ===================================================== -->

            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,Auto"
                Margin="0,2">

                <TextBlock
                    Text="Tracks Scanned"/>

                <TextBlock
                    Grid.Column="1"
                    FontWeight="SemiBold">

                    <Run Text="{Binding TracksScanned, ElementName=Root, StringFormat={}{0:N0}}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalTracks, ElementName=Root, StringFormat={}{0:N0}}"/>

                </TextBlock>

            </Grid>

            <!-- ===================================================== -->
            <!-- Issues -->
            <!-- ===================================================== -->

            <Grid
                Grid.Row="3"
                ColumnDefinitions="*,Auto"
                Margin="0,2">

                <TextBlock
                    Text="Issues Found"/>

                <TextBlock
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Text="{Binding IssuesFound, ElementName=Root, StringFormat={}{0:N0}}"/>

            </Grid>

            <!-- ===================================================== -->
            <!-- Health -->
            <!-- ===================================================== -->

            <Grid
                Grid.Row="4"
                ColumnDefinitions="*,Auto"
                Margin="0,2">

                <TextBlock
                    Text="Overall Health"/>

                <TextBlock
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Text="{Binding HealthScore,
                                   ElementName=Root,
                                   StringFormat={}{0:F1}%}"/>

            </Grid>

            <!-- ===================================================== -->
            <!-- Last Analysed -->
            <!-- ===================================================== -->

            <Grid
                Grid.Row="5"
                ColumnDefinitions="*,Auto"
                Margin="0,2">

                <TextBlock
                    Text="Last Analysed"/>

                <TextBlock
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Text="{Binding LastAnalysed,
                                   ElementName=Root,
                                   TargetNullValue=Never,
                                   StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"/>

            </Grid>

            <!-- ===================================================== -->
            <!-- Progress -->
            <!-- ===================================================== -->

            <StackPanel
                Grid.Row="7"
                Spacing="6">

                <TextBlock
                    FontWeight="SemiBold"
                    Text="Progress"/>

                <ProgressBar
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding Progress,
                                    ElementName=Root}"/>

            </StackPanel>

            <!-- ===================================================== -->
            <!-- Current Stage -->
            <!-- ===================================================== -->

            <StackPanel
                Grid.Row="9"
                Spacing="2">

                <TextBlock
                    FontWeight="SemiBold"
                    Text="Current Stage"/>

                <TextBlock
                    Text="{Binding CurrentStage,
                                   ElementName=Root}"/>

            </StackPanel>

            <!-- ===================================================== -->
            <!-- Current Track -->
            <!-- ===================================================== -->

            <StackPanel
                Grid.Row="11"
                Spacing="2">

                <TextBlock
                    FontWeight="SemiBold"
                    Text="Current Track"/>

                <TextBlock
                    Text="{Binding CurrentTrack,
                                   ElementName=Root}"
                    TextTrimming="CharacterEllipsis"/>

            </StackPanel>

            <!-- ===================================================== -->
            <!-- Action -->
            <!-- ===================================================== -->

            <Button
                Grid.Row="13"
                HorizontalAlignment="Right"
                Theme="{StaticResource DJLM.PrimaryButton}"
                Content="Analyse Library"
                Command="{Binding AnalyseCommand,
                                  ElementName=Root}"/>

        </Grid>

    </Border>

</UserControl>