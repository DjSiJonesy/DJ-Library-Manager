<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DJLibraryManager.UI.Models.Search"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowSearchResults"
    x:Name="Root">

    <Border
        Classes="card-secondary"
        Padding="12">

        <Grid
            RowDefinitions="Auto,12,*">

            <!-- ================================================= -->
            <!-- Heading -->
            <!-- ================================================= -->

            <TextBlock
                Grid.Row="0"
                Classes="subheading"
                Text="{Binding Heading,
                               ElementName=Root}" />

            <!-- ================================================= -->
            <!-- Results -->
            <!-- ================================================= -->

            <ListBox
                Grid.Row="2"
                ItemsSource="{Binding Results,
                                      ElementName=Root}"
                ScrollViewer.VerticalScrollBarVisibility="Auto">

                <!-- ============================================= -->
                <!-- Virtualised Items -->
                <!-- ============================================= -->

                <ListBox.ItemsPanel>

                    <ItemsPanelTemplate>

                        <VirtualizingStackPanel />

                    </ItemsPanelTemplate>

                </ListBox.ItemsPanel>

                <!-- ============================================= -->
                <!-- Result Template -->
                <!-- ============================================= -->

                <ListBox.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:SearchResult">

                        <Border
                            Padding="10"
                            Margin="0,4"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6">

                            <Grid
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                                <!-- ================================= -->
                                <!-- Track -->
                                <!-- ================================= -->

                                <Grid
                                    Grid.Row="0"
                                    ColumnDefinitions="*,Auto">

                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="2">

                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding TrackTitle,
                                                           TargetNullValue=Unknown Track}" />

                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding Artist,
                                                           TargetNullValue=Unknown Artist}" />

                                        <TextBlock
                                            Classes="caption"
                                            Text="{Binding Album,
                                                           TargetNullValue=No Album}" />

                                    </StackPanel>

                                    <!-- Match -->

                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Text="{Binding MatchScore,
                                                       StringFormat={}{0:F1}%}" />

                                </Grid>

                                <!-- ================================= -->
                                <!-- Music Information -->
                                <!-- ================================= -->

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    ColumnDefinitions="*,*,*">

                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="2">

                                        <TextBlock
                                            Classes="caption"
                                            Text="BPM" />

                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding Bpm,
                                                           StringFormat={}{0:F0}}" />

                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="2">

                                        <TextBlock
                                            Classes="caption"
                                            Text="Key" />

                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding Key,
                                                           TargetNullValue=—}" />

                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Spacing="2">

                                        <TextBlock
                                            Classes="caption"
                                            Text="Duration" />

                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding Duration,
                                                           StringFormat={}{0:mm\\:ss}}" />

                                    </StackPanel>

                                </Grid>

                                <!-- ================================= -->
                                <!-- File -->
                                <!-- ================================= -->

                                <StackPanel
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    Spacing="2">

                                    <TextBlock
                                        Classes="caption"
                                        Text="{Binding FilePath}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Classes="caption"
                                        Text="{Binding FileSize,
                                                       StringFormat=Size: {0:N0} bytes}" />

                                </StackPanel>

                                <!-- ================================= -->
                                <!-- Recommendation -->
                                <!-- ================================= -->

                                <StackPanel
                                    Grid.Row="3"
                                    Margin="0,8,0,0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding Source}" />

                                    <TextBlock
                                        Classes="caption"
                                        Text="{Binding RecommendationReason}"
                                        TextWrapping="Wrap" />

                                    <!-- Recommended indicator -->

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        IsVisible="{Binding IsRecommended}">

                                        <!-- Green recommendation indicator -->

                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            VerticalAlignment="Center"
                                            Fill="LimeGreen" />

                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="LimeGreen"
                                            Text="RECOMMENDED" />

                                    </StackPanel>

                                </StackPanel>

                                <!-- ================================= -->
                                <!-- Keep Selection -->
                                <!-- ================================= -->

                                <Button
                                    Grid.Row="4"
                                    Margin="0,10,0,0"
                                    HorizontalContentAlignment="Left"
                                    Click="KeepResult_Click"
                                    IsVisible="{Binding IsDuplicateResults,
                                                        ElementName=Root}">

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">

                                        <!-- Selected -->

                                        <TextBlock
                                            FontSize="14"
                                            Text="☑"
                                            IsVisible="{Binding IsSelected}" />

                                        <!-- Not Selected -->

                                        <TextBlock
                                            FontSize="14"
                                            Text="☐"
                                            IsVisible="{Binding !IsSelected}" />

                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="KEEP THIS COPY" />

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>

    </Border>

</UserControl>