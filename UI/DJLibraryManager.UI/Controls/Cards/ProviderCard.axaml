<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:DJLibraryManager.UI.Controls.Cards"
    x:Class="DJLibraryManager.UI.Controls.Cards.ProviderCard"
    x:DataType="cards:ProviderCard">

    <Border
        Classes="card"
        Width="170"
        Height="180"
        Margin="0,0,15,15">

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10">

            <TextBlock
                Classes="section"
                HorizontalAlignment="Center"
                Text="{Binding ProviderName,
                               RelativeSource={RelativeSource AncestorType=cards:ProviderCard}}" />

            <Image
                Width="100"
                Height="60"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                Source="{Binding ProviderLogo,
                                 RelativeSource={RelativeSource AncestorType=cards:ProviderCard}}" />

            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{DynamicResource Brush.Accent}"
                Text="{Binding Status,
                               RelativeSource={RelativeSource AncestorType=cards:ProviderCard}}" />

        </StackPanel>

    </Border>

</UserControl>