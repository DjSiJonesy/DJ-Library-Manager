<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DJLibraryManager.UI.Models.Analysis"
    xmlns:analysis="using:DJLibraryManager.UI.ViewModels.Analysis"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowAnalysisTable"
    x:DataType="analysis:AnalysisWorkspaceViewModel"
    x:Name="Root">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- Analysis Category Row -->
        <!-- ===================================================== -->

        <DataTemplate
            x:Key="CategoryTemplate"
            x:DataType="models:AnalysisCategoryInfo">

            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Padding="0,6"
                Margin="0,2"
                Command="{Binding DataContext.SelectCategoryCommand,
                                  ElementName=Root}"
                CommandParameter="{Binding}">

                <Grid
                    ColumnDefinitions="100,*,100,100">

                    <!-- ================================================= -->
                    <!-- Category -->
                    <!-- ================================================= -->

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding Name}" />

                    <!-- ================================================= -->
                    <!-- Description -->
                    <!-- ================================================= -->

                    <TextBlock
                        Grid.Column="1"
                        Margin="16,0,20,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Classes="caption"
                        Text="{Binding Description}"
                        TextWrapping="Wrap" />

                    <!-- ================================================= -->
                    <!-- Issues -->
                    <!-- ================================================= -->

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Text="{Binding IssueCount,
                                       StringFormat={}{0:N0}}" />

                    <!-- ================================================= -->
                    <!-- Health -->
                    <!-- ================================================= -->

                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Text="{Binding HealthScore,
                                       StringFormat={}{0:F1}%}" />

                </Grid>

            </Button>

        </DataTemplate>

    </UserControl.Resources>

    <Border
        Classes="card-secondary"
        Padding="12">

        <Grid
            RowDefinitions="Auto,12,Auto,6,Auto,*">

            <!-- ===================================================== -->
            <!-- Heading -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Row="0"
                Classes="subheading"
                Text="Issue Breakdown" />

            <!-- ===================================================== -->
            <!-- Column Headings -->
            <!-- ===================================================== -->

            <Grid
                Grid.Row="2"
                ColumnDefinitions="100,*,100,100">

                <TextBlock
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Text="Category" />

                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,20,0"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Text="Description" />

                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Text="Issues" />

                <TextBlock
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Text="Health" />

            </Grid>

            <!-- ===================================================== -->
            <!-- Divider -->
            <!-- ===================================================== -->

            <Border
                Grid.Row="4"
                Height="1"
                Background="#303030" />

            <!-- ===================================================== -->
            <!-- Analysis Categories -->
            <!-- ===================================================== -->

            <ItemsControl
                Grid.Row="5"
                FontSize="12"
                ItemsSource="{Binding Categories, ElementName=Root}"
                ItemTemplate="{StaticResource CategoryTemplate}" />

        </Grid>

    </Border>

</UserControl>