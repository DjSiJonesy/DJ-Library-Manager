<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:rows="using:DJLibraryManager.UI.Controls.Rows"
    x:Class="DJLibraryManager.UI.Views.MediaLocationWorkspaceView"
    x:DataType="vm:MediaLocationWorkspaceViewModel"
    mc:Ignorable="d">

    <Grid
        RowDefinitions="Auto,20,Auto,20,*">

        <!-- ===================================================== -->
        <!-- Header -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Classes="heading"
                Text="Media Location"/>

            <TextBlock
                Classes="caption"
                Text="Discover and analyse media stored in this location."/>

        </StackPanel>

        <!-- ===================================================== -->
        <!-- Location Information -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="2"
            Classes="card-secondary"
            Padding="20">

            <Grid
                ColumnDefinitions="*,240"
                RowDefinitions="Auto,20,Auto">

                <!-- ================================================= -->
                <!-- Card Header -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    ColumnDefinitions="*,Auto">

                    <TextBlock
                        Classes="section"
                        VerticalAlignment="Center"
                        Text="Media Location"/>

                    <Button
                        Grid.Column="1"
                        Width="180"
                        Height="44"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Theme="{StaticResource DJLM.PrimaryButton}"
                        Command="{Binding DiscoverMediaCommand}"
                        Content="🔍 Discover Media"/>

                </Grid>

                <!-- ================================================= -->
<!-- Left Information -->
<!-- ================================================= -->

<Grid
    Grid.Row="2"
    Grid.Column="0"
    ColumnDefinitions="120,*"
    RowDefinitions="Auto,Auto,Auto,Auto"
    RowSpacing="10">

    <!-- ================================================= -->
    <!-- Name -->
    <!-- ================================================= -->

    <Grid
        Grid.Row="0"
        Grid.Column="0"
        ColumnDefinitions="20,*"
        ColumnSpacing="6">

        <TextBlock
            VerticalAlignment="Center"
            Text="🏷️"/>

        <TextBlock
            Grid.Column="1"
            Classes="body"
            VerticalAlignment="Center"
            Text="Name"/>

    </Grid>

    <TextBlock
        Grid.Row="0"
        Grid.Column="1"
        Classes="body"
        VerticalAlignment="Center"
        Text="{Binding Name}"/>

    <!-- ================================================= -->
    <!-- Path -->
    <!-- ================================================= -->

    <Grid
        Grid.Row="1"
        Grid.Column="0"
        ColumnDefinitions="20,*"
        ColumnSpacing="6">

        <Button
            Width="20"
            Height="20"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            VerticalAlignment="Center"
            Command="{Binding OpenFolderCommand}">

            <TextBlock
                VerticalAlignment="Center"
                Text="📁"/>

        </Button>

        <TextBlock
            Grid.Column="1"
            Classes="body"
            VerticalAlignment="Center"
            Text="Path"/>

    </Grid>

    <Button
        Grid.Row="1"
        Grid.Column="1"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        Cursor="Hand"
        HorizontalAlignment="Left"
        HorizontalContentAlignment="Left"
        Command="{Binding OpenFolderCommand}">

        <TextBlock
            Classes="body"
            VerticalAlignment="Center"
            Text="{Binding Path}"
            TextTrimming="CharacterEllipsis"/>

    </Button>

    <!-- ================================================= -->
    <!-- Drive -->
    <!-- ================================================= -->

    <Grid
        Grid.Row="2"
        Grid.Column="0"
        ColumnDefinitions="20,*"
        ColumnSpacing="6">

        <TextBlock
            VerticalAlignment="Center"
            Text="💽"/>

        <TextBlock
            Grid.Column="1"
            Classes="body"
            VerticalAlignment="Center"
            Text="Drive"/>

    </Grid>

    <TextBlock
        Grid.Row="2"
        Grid.Column="1"
        Classes="body"
        VerticalAlignment="Center"
        Text="{Binding Drive}"/>

    <!-- ================================================= -->
    <!-- Status -->
    <!-- ================================================= -->

    <Grid
        Grid.Row="3"
        Grid.Column="0"
        ColumnDefinitions="20,*"
        ColumnSpacing="6">

        <Ellipse
            Width="10"
            Height="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="{Binding StatusBrush}"/>

        <TextBlock
            Grid.Column="1"
            Classes="body"
            VerticalAlignment="Center"
            Text="Status"/>

    </Grid>

    <TextBlock
        Grid.Row="3"
        Grid.Column="1"
        Classes="body"
        VerticalAlignment="Center"
        Text="{Binding Status}"/>

</Grid>

                <!-- ================================================= -->
                <!-- Discovery Summary -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="30,0,0,0"
                    ColumnDefinitions="110,*"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="10">

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Classes="body"
                        Text="Folders"/>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Classes="body"
                        Text="{Binding FolderCount}"/>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Classes="body"
                        Text="Audio Files"/>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Classes="body"
                        Text="{Binding AudioFileCount}"/>

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Classes="body"
                        Text="Video Files"/>

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Classes="body"
                        Text="{Binding VideoFileCount}"/>

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Classes="body"
                        Text="Total Size"/>

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Classes="body"
                        Text="{Binding TotalSize}"/>

                </Grid>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- Discovered Media Folders -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="4"
            Classes="card"
            Padding="20">

            <Grid
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="12">

                <!-- ================================================= -->
                <!-- Heading -->
                <!-- ================================================= -->

                <TextBlock
                    Grid.Row="0"
                    Classes="section"
                    Text="Discovered Media Folders"/>

                <!-- ================================================= -->
                <!-- Column Headings -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="1"
                    Margin="8,0,24,0"
                    ColumnDefinitions="*,90,90,90"
                    ColumnSpacing="20">

                    <TextBlock
                        Grid.Column="0"
                        FontWeight="Bold"
                        Text="Folder"/>

                    <TextBlock
                        Grid.Column="1"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Text="Audio"/>

                    <TextBlock
                        Grid.Column="2"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Text="Video"/>

                    <TextBlock
                        Grid.Column="3"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Text="Total"/>

                </Grid>

                <Border
                    Grid.Row="2"
                    Height="1"
                    Background="#555"/>

                <!-- ================================================= -->
                <!-- Folder List -->
                <!-- ================================================= -->

                <ScrollViewer
                    Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl
                        ItemsSource="{Binding Libraries}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <rows:MediaFolderRow
                                    Folder="{Binding Path}"
                                    AudioCount="{Binding AudioFileCount}"
                                    VideoCount="{Binding VideoFileCount}"
                                    TotalCount="{Binding TotalMediaFiles}" />

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>