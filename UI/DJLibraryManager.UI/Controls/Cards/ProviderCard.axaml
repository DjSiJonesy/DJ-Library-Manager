<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:DJLibraryManager.UI.Controls.Cards"
    x:Class="DJLibraryManager.UI.Controls.Cards.ProviderCard"
    x:DataType="cards:ProviderCard">

    <UserControl.Styles>

        <!-- Grey-out the card contents when the provider is not installed -->
        <Style Selector="cards|ProviderCard[Installed=False] StackPanel">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- Grey status text when not installed -->
        <Style Selector="cards|ProviderCard[Installed=False] TextBlock.status">
            <Setter Property="Foreground" Value="#808080"/>
        </Style>

    </UserControl.Styles>

    <Border
        Classes="card"
        Width="160"
        Height="160"
        Margin="0,0,15,15">

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10">

            <TextBlock
                Classes="section"
                HorizontalAlignment="Center"
                Text="{Binding ProviderName,
                               RelativeSource={RelativeSource AncestorType=cards:ProviderCard}}" />

            <Border
                Width="68"
                Height="68"
                CornerRadius="8"
                ClipToBounds="True"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                HorizontalAlignment="Center">

                <Image
                    Stretch="Uniform"
                    Source="{Binding ProviderLogo,
                                     RelativeSource={RelativeSource AncestorType=cards:ProviderCard}}" />

            </Border>

            <TextBlock
                Classes="status"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource Brush.Accent}"
                Text="{Binding Status,
                               RelativeSource={RelativeSource AncestorType=cards:ProviderCard}}" />

        </StackPanel>

    </Border>

</UserControl>