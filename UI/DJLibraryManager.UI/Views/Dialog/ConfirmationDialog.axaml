<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DJLibraryManager.UI.Views.Dialogs.ConfirmationDialog"
    x:DataType="local:ConfirmationDialog"
    xmlns:local="using:DJLibraryManager.UI.Views.Dialogs"
    Width="480"
    MinWidth="420"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <Border
        Padding="24"
        Background="{DynamicResource Brush.Background}">

        <Grid
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="18">

            <!-- Title -->

            <TextBlock
                Grid.Row="0"
                Text="{Binding Title}"
                FontSize="18"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />

            <!-- Message -->

            <TextBlock
                Grid.Row="1"
                Text="{Binding ConfirmationMessage}"
                FontSize="13"
                TextWrapping="Wrap"
                MaxWidth="420" />

            <!-- Actions -->

            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="10">

                <Button
                    Grid.Column="1"
                    Content="Cancel"
                    MinWidth="90"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsCancel="True"
                    Click="Cancel_Click" />

                <Button
                    Grid.Column="2"
                    Content="{Binding ConfirmButtonText}"
                    MinWidth="110"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsDefault="True"
                    Click="Confirm_Click" />

            </Grid>

        </Grid>

    </Border>

</Window>