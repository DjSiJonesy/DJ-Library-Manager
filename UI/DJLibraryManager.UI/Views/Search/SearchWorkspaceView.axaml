<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels.Search"
    xmlns:models="using:DJLibraryManager.UI.Models.Search"
    xmlns:workflow="using:DJLibraryManager.UI.Controls.Workflow"
    xmlns:converters="using:DJLibraryManager.UI.Converters"
    x:Class="DJLibraryManager.UI.Views.Search.SearchWorkspaceView"
    x:DataType="vm:SearchWorkspaceViewModel">

    <UserControl.Resources>

        <converters:StringEqualsConverter
            x:Key="StringEqualsConverter"/>

    </UserControl.Resources>

    <Grid
        RowDefinitions="Auto,20,*">

        <!-- ===================================================== -->
        <!-- Header -->
        <!-- ===================================================== -->

        <workflow:WorkflowHeader
            Grid.Row="0"
            Title="Search"
            Description="Find information and potential solutions for issues identified during library analysis."
            PreviousText="← Analysis"
            PreviousCommand="{Binding PreviousCommand}"
            NextText="Improve →"
            NextCommand="{Binding NextCommand}"/>

        <!-- ===================================================== -->
        <!-- Main Search Area -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="2"
            ColumnDefinitions="300,20,*">

            <!-- ================================================= -->
            <!-- Search Categories -->
            <!-- ================================================= -->

            <Border
                Grid.Column="0"
                Classes="card-secondary"
                Padding="12">

                <Grid
                    RowDefinitions="Auto,12,*">

                    <TextBlock
                        Grid.Row="0"
                        Classes="subheading"
                        Text="Search Categories"/>

                    <ListBox
                        Grid.Row="2"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}">

                        <ListBox.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:SearchCategoryInfo">

                                <Border
                                    Padding="10"
                                    Margin="0,4"
                                    CornerRadius="6">

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        RowDefinitions="Auto,Auto">

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"/>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            FontSize="12"
                                            HorizontalAlignment="Right"
                                            Text="{Binding IssueCount,
                                                           StringFormat={}{0:N0}}"/>

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Margin="0,4,0,0"
                                            Classes="caption"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- Category Content -->
            <!-- ================================================= -->

            <Grid
                Grid.Column="2"
                RowDefinitions="Auto,20,*">

                <!-- ================================================= -->
                <!-- Category Header -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="0"
                    Classes="card-secondary"
                    Padding="12">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <StackPanel
                            Spacing="3">

                            <TextBlock
                                Classes="subheading"
                                Text="{Binding SelectedCategory.Name,
                                               TargetNullValue=Search}"/>

                            <TextBlock
                                Classes="caption"
                                Text="{Binding SelectedCategory.Description,
                                               TargetNullValue=Select a Search category.}"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Margin="0,6,0,0"
                                Classes="caption"
                                Text="{Binding SearchStatus}"/>

                        </StackPanel>

                        <!-- ================================================= -->
                        <!-- Actions -->
                        <!-- ================================================= -->

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                            <!-- Search Selected Issue -->

                            <Button
                                Theme="{StaticResource DJLM.PrimaryButton}"
                                Content="Search"
                                Command="{Binding SearchIssueCommand}"
                                CommandParameter="{Binding SelectedIssue}"
                                IsEnabled="{Binding !IsSearching}"/>

                            <!-- Search All Duplicates -->

                            <Button
                                Theme="{StaticResource DJLM.PrimaryButton}"
                                Content="Search All Duplicates"
                                Command="{Binding SearchAllDuplicatesCommand}"
                                IsVisible="{Binding SelectedCategory.Name,
                                                     Converter={StaticResource StringEqualsConverter},
                                                     ConverterParameter=Duplicates}"
                                IsEnabled="{Binding !IsSearching}"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- Issues + Results -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="320,20,*">

                    <!-- ================================================= -->
                    <!-- Issues -->
                    <!-- ================================================= -->

                    <Border
                        Grid.Column="0"
                        Classes="card-secondary"
                        Padding="12">

                        <Grid
                            RowDefinitions="Auto,12,*">

                            <TextBlock
                                Grid.Row="0"
                                Classes="subheading"
                                Text="Issues"/>

                            <ListBox
                                Grid.Row="2"
                                ItemsSource="{Binding Issues}"
                                SelectedItem="{Binding SelectedIssue}">

                                <ListBox.ItemTemplate>

                                    <DataTemplate
                                        x:DataType="models:SearchIssue">

                                        <Border
                                            Padding="8"
                                            Margin="0,3"
                                            CornerRadius="5">

                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                RowDefinitions="Auto,Auto">

                                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Spacing="2">

                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Title}"/>

                                                    <TextBlock
                                                        Classes="caption"
                                                        Text="{Binding Description}"
                                                        TextTrimming="CharacterEllipsis"/>

                                                </StackPanel>

                                                <!-- Searched -->

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    FontSize="11"
                                                    HorizontalAlignment="Right"
                                                    Text="✓"
                                                    IsVisible="{Binding IsSearched}"/>

                                                <!-- Issue Type -->

                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,4,0,0"
                                                    Classes="caption"
                                                    Text="{Binding Type}"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                        </Grid>

                    </Border>

                    <!-- ================================================= -->
                    <!-- Selected Issue / Results -->
                    <!-- ================================================= -->

                    <Grid
                        Grid.Column="2"
                        RowDefinitions="Auto,20,*">

                        <!-- Selected Issue -->

                        <Border
                            Grid.Row="0"
                            Classes="card-secondary"
                            Padding="12">

                            <StackPanel
                                Spacing="4">

                                <TextBlock
                                    Classes="subheading"
                                    Text="{Binding SelectedIssue.Title,
                                                   TargetNullValue=Select an Issue}"/>

                                <TextBlock
                                    Classes="caption"
                                    Text="{Binding SelectedIssue.Description,
                                                   TargetNullValue=Select an issue from the list to investigate it.}"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Classes="caption"
                                    Text="{Binding SelectedIssue.FilePath}"
                                    TextTrimming="CharacterEllipsis"/>

                            </StackPanel>

                        </Border>

                        <!-- Search Results -->

                        <workflow:WorkflowSearchResults
                            Grid.Row="2"
                            Heading="{Binding SelectedCategory.Name}"
                            Results="{Binding SelectedIssue.Results}"/>

                    </Grid>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</UserControl>