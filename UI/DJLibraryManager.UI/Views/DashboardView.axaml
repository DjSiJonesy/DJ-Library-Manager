<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:cards="using:DJLibraryManager.UI.Controls.Cards"
    xmlns:panels="using:DJLibraryManager.UI.Controls.Panels"
    x:Class="DJLibraryManager.UI.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    mc:Ignorable="d">

    <Border
        Classes="card"
        Padding="25">

        <Grid
            ColumnDefinitions="3*,2*"
            ColumnSpacing="30">

            <!-- ===================================================== -->
            <!-- LEFT -->
            <!-- ===================================================== -->

            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Classes="heading"
                    Text="Startup Discovery"/>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Classes="body"
                    Text="The application automatically discovers installed DJ software and music libraries." />

                <!-- Providers -->

                <StackPanel
                    Grid.Row="2"
                    Margin="0,25,0,0"
                    Spacing="12">

                    <TextBlock
                        Classes="section"
                        Text="Installed DJ Software"/>

                    <ItemsControl
                        ItemsSource="{Binding InstalledProviders}">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <WrapPanel Orientation="Horizontal"/>

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <cards:ProviderCard/>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

                <!-- Bottom -->

                <StackPanel
                    Grid.Row="4"
                    Margin="0,25,0,0"
                    Spacing="20">

                    <Border Classes="card">

                        <StackPanel Spacing="15">

                            <TextBlock
                                Classes="section"
                                Text="File Locations"/>

                            <TextBlock
                                Classes="listitem"
                                Text="(Music locations and folder shortcuts will move here)"/>

                        </StackPanel>

                    </Border>

                    <Button
                        Theme="{StaticResource DJLM.PrimaryButton}"
                        HorizontalAlignment="Left"
                        Content="Analyse Library"/>

                </StackPanel>

            </Grid>

            <!-- ===================================================== -->
            <!-- RIGHT -->
            <!-- ===================================================== -->

            <Border
                Grid.Column="1"
                Classes="card"
                Padding="20">

                <!--
                    During this transition the dashboard hosts the
                    ProviderWorkspacePanel. It is displayed once a
                    provider has been selected.
                -->

                <ContentControl
                    IsVisible="{Binding SelectedProvider}">

                    <panels:ProviderWorkspacePanel
                        DataContext="{Binding SelectedProvider}" />

                </ContentControl>

            </Border>

        </Grid>

    </Border>

</UserControl>