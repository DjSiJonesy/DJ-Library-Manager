<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DJLibraryManager.UI.Controls.Dashboard.WorkflowGuidanceCard"
    x:Name="Root">

    <Border
        Classes="card-secondary"
        Padding="18"
        MinWidth="340"
        Height="190">

        <Grid
            RowDefinitions="Auto,12,*">

            <!-- ===================================================== -->
            <!-- Header -->
            <!-- ===================================================== -->

            <Grid
                ColumnDefinitions="Auto,Auto,16,*"
                VerticalAlignment="Center">

                <!-- Icon -->

                <TextBlock
                    FontSize="22"
                    VerticalAlignment="Center"
                    Text="🎯"/>

                <!-- Stage -->

                <TextBlock
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Classes="section"
                    VerticalAlignment="Center"
                    Text="{Binding Title, ElementName=Root}"/>

                <!-- Next Step -->

                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="6">

                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource Brush.Accent}"
                        Text="▶"/>

                    <TextBlock
                        Classes="caption"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        MaxWidth="320"
                        Text="{Binding NextStep, ElementName=Root}"/>

                </StackPanel>

            </Grid>

            <!-- ===================================================== -->
            <!-- Bottom -->
            <!-- ===================================================== -->

            <Border
                Grid.Row="2"
                CornerRadius="6"
                Padding="12"
                Background="#22000000">

                <Grid
                    ColumnDefinitions="*,20,*">

                    <!-- ================================================= -->
                    <!-- Left -->
                    <!-- ================================================= -->

                    <StackPanel>

                        <TextBlock
                            Classes="caption"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8"
                            Text="What happens"/>

                        <ItemsControl
                            ItemsSource="{Binding WhatHappens, ElementName=Root}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Margin="0,2">

                                        <TextBlock
                                            FontSize="13"
                                            Text="✓"/>

                                        <TextBlock
                                            Margin="8,0,0,0"
                                            FontSize="12"
                                            Text="{Binding}"/>

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                    <!-- ================================================= -->
                    <!-- Right -->
                    <!-- ================================================= -->

                    <StackPanel
                        Grid.Column="2">

                        <TextBlock
                            Classes="caption"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8"
                            Text="Good to know"/>

                        <ItemsControl
                            ItemsSource="{Binding GoodToKnow, ElementName=Root}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Margin="0,2">

                                        <TextBlock
                                            FontSize="13"
                                            Text="•"/>

                                        <TextBlock
                                            Margin="8,0,0,0"
                                            FontSize="12"
                                            Text="{Binding}"/>

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>