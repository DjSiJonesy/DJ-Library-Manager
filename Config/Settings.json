{
  "Application": {
    "Name": "DJ Library Manager",
    "Version": "0.9.0-alpha",
    "Author": "Simon Jones",
    "Company": "SMSounds Limited"
  },

  "Providers": {
    "Default": "VirtualDJ",

    "VirtualDJ": {
      "DatabasePath": "C:\\Users\\Simon\\AppData\\Local\\VirtualDJ\\database.xml"
    }
  },

  "Library": {
    "Paths": [
      "C:\\Users\\Simon\\Music"
    ],

    "Recurse": true,

    "IndexFolder": "Data"
  },

  "Logging": {
    "Enabled": true,
    "LogFolder": "Logs",
    "LogLevel": "Information"
  },

  "Reports": {
    "OutputFolder": "Reports"
  },

  "Display": {
    "ShowBanner": true,
    "ShowProgress": true
  }
}