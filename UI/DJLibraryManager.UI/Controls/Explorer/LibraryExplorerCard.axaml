<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DJLibraryManager.Core.Models"
    xmlns:common="using:DJLibraryManager.UI.Controls.Common"
    x:Class="DJLibraryManager.UI.Controls.Explorer.LibraryExplorerCard"
    x:DataType="models:MediaLibrary">

    <Border
        Classes="card-secondary"
        Margin="0,0,0,12"
        Padding="16">

        <TextBlock
            Classes="section"
            Text="{Binding Name}" />

    </Border>

</UserControl>