<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:analysis="using:DJLibraryManager.UI.ViewModels.Analysis"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowAnalysisDetailCard"
    x:DataType="analysis:AnalysisWorkspaceViewModel">

    <Border
        Classes="card-secondary"
        Padding="12">

        <Grid
            RowDefinitions="Auto,8,Auto,*">

            <!-- ===================================================== -->
            <!-- Heading -->
            <!-- ===================================================== -->

            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto">

                <TextBlock
                    Grid.Column="0"
                    Classes="subheading"
                    Text="{Binding SelectedCategory.Name,
                                   TargetNullValue=Analysis Details}" />

                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    Text="{Binding SelectedCategoryHealthScore,
                                   StringFormat={}{0:F1}%}" />

            </Grid>

            <!-- ===================================================== -->
            <!-- Summary -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Row="2"
                FontSize="12"
                Text="{Binding SelectedCategoryIssueCount,
                               StringFormat={}{0:N0} issues found}" />

            <!-- ===================================================== -->
            <!-- Detail Content -->
            <!-- ===================================================== -->

            <ScrollViewer
                Grid.Row="3"
                Margin="0,8,0,0"
                VerticalScrollBarVisibility="Auto">

                <StackPanel
                    Spacing="8">

                    <!-- ================================================= -->
                    <!-- Metadata -->
                    <!-- ================================================= -->

                    <Border
                        IsVisible="{Binding IsMetadataSelected}"
                        Classes="card-tertiary"
                        Padding="10">

                        <StackPanel
                            Spacing="8">

                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Metadata Issues" />

                            <!-- ================================================= -->
                            <!-- Metadata Summary -->
                            <!-- ================================================= -->

                            <Grid
                                ColumnDefinitions="*,*,*,*,*,*,*,*"
                                ColumnSpacing="8">

                                <!-- Artist -->

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Text="Artist" />

                                    <TextBlock
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        Text="{Binding MissingArtistCount,
                                                       StringFormat={}{0:N0}}" />

                                </StackPanel>

                                <!-- Title -->

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Text="Title" />

                                    <TextBlock
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        Text="{Binding MissingTitleCount,
                                                       StringFormat={}{0:N0}}" />

                                </StackPanel>

                                <!-- Album -->

                                <StackPanel
                                    Grid.Column="2"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Text="Album" />

                                    <TextBlock
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        Text="{Binding MissingAlbumCount,
                                                       StringFormat={}{0:N0}}" />

                                </StackPanel>

                                <!-- Genre -->

                                <StackPanel
                                    Grid.Column="3"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Text="Genre" />

                                    <TextBlock
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        Text="{Binding MissingGenreCount,
                                                       StringFormat={}{0:N0}}" />

                                </StackPanel>

                                <!-- Year -->

                                <StackPanel
                                    Grid.Column="4"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Text="Year" />

                                    <TextBlock
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        Text="{Binding MissingYearCount,
                                                       StringFormat={}{0:N0}}" />

                                </StackPanel>

                                <!-- BPM -->

                                <StackPanel
                                    Grid.Column="5"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Text="BPM" />

                                    <TextBlock
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        Text="{Binding MissingBPMCount,
                                                       StringFormat={}{0:N0}}" />

                                </StackPanel>

                                <!-- Musical Key -->

                                <StackPanel
                                    Grid.Column="6"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Text="Key" />

                                    <TextBlock
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        Text="{Binding MissingKeyCount,
                                                       StringFormat={}{0:N0}}" />

                                </StackPanel>

                                <!-- Duration -->

                                <StackPanel
                                    Grid.Column="7"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Text="Duration" />

                                    <TextBlock
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        Text="{Binding MissingDurationCount,
                                                       StringFormat={}{0:N0}}" />

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- ================================================= -->
                    <!-- File Integrity -->
                    <!-- ================================================= -->

                    <Border
                        IsVisible="{Binding IsFileIntegritySelected}"
                        Classes="card-tertiary"
                        Padding="10">

                        <StackPanel
                            Spacing="6">

                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="File Integrity Issues" />

                            <TextBlock
                                FontSize="12"
                                Text="{Binding SelectedCategoryIssueCount,
                                               StringFormat={}{0:N0} files require attention.}" />

                        </StackPanel>

                    </Border>

                    <!-- ================================================= -->
                    <!-- Duplicates -->
                    <!-- ================================================= -->

                    <Border
                        IsVisible="{Binding IsDuplicatesSelected}"
                        Classes="card-tertiary"
                        Padding="10">

                        <StackPanel
                            Spacing="6">

                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Duplicate Groups" />

                            <TextBlock
                                FontSize="12"
                                Text="{Binding SelectedCategoryIssueCount,
                                               StringFormat={}{0:N0} duplicate groups identified.}" />

                            <TextBlock
                                FontSize="12"
                                Classes="caption"
                                Text="Select a duplicate group to investigate it in Search." />

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</UserControl>