<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:workflow="using:DJLibraryManager.UI.Controls.Workflow"
    xmlns:media="using:DJLibraryManager.Core.Models"
    x:Class="DJLibraryManager.UI.Controls.Workflow.WorkflowMediaFolderTable"
    x:Name="Root">

    <Border
        Classes="card"
        Padding="12">

        <Grid
            RowDefinitions="Auto,12,Auto,8,*,8">

            <!-- ===================================================== -->
            <!-- Heading -->
            <!-- ===================================================== -->

            <TextBlock
                Grid.Row="0"
                Classes="subheading"
                Text="Discovered Media Folders"/>

            <!-- ===================================================== -->
            <!-- Column Headings -->
            <!-- ===================================================== -->

            <!--
                IMPORTANT

                The final 18px column is a permanent scrollbar gutter.

                This keeps the header aligned whether or not a scrollbar
                is visible.
            -->

            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,90,90,90,18">

                <TextBlock
                    Grid.Column="0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="Folder"/>

                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Right"
                    Text="Audio"/>

                <TextBlock
                    Grid.Column="2"
                    FontSize="12"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Right"
                    Text="Video"/>

                <TextBlock
                    Grid.Column="3"
                    FontSize="12"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Right"
                    Text="Total"/>

            </Grid>

            <!-- ===================================================== -->
            <!-- Divider -->
            <!-- ===================================================== -->

            <Border
                Grid.Row="3"
                Height="1"
                Background="#404040"/>

            <!-- ===================================================== -->
            <!-- Rows -->
            <!-- ===================================================== -->

            <ScrollViewer
                Grid.Row="4"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <Grid
                    ColumnDefinitions="*,18">

                    <!-- Row Area -->

                    <ItemsControl
                        Grid.Column="0"
                        ItemsSource="{Binding Libraries, ElementName=Root}">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate
                                x:DataType="media:MediaLibrary">

                                <workflow:WorkflowMediaFolderRow
                                    Folder="{Binding Path}"
                                    AudioCount="{Binding AudioFileCount}"
                                    VideoCount="{Binding VideoFileCount}"
                                    TotalCount="{Binding TotalMediaFiles}" />

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <!--
                        Grid.Column="1"

                        Reserved scrollbar gutter.

                        Intentionally empty.
                    -->

                </Grid>

            </ScrollViewer>

        </Grid>

    </Border>

</UserControl>