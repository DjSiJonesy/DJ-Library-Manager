<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:common="using:DJLibraryManager.UI.Controls.Common"
    xmlns:workflow="using:DJLibraryManager.UI.Controls.Workflow"
    x:Class="DJLibraryManager.UI.Views.MediaLocationWorkspaceView"
    x:DataType="vm:MediaLocationWorkspaceViewModel"
    mc:Ignorable="d">

    <Grid
        RowDefinitions="Auto,16,Auto,16,*">

        <!-- ===================================================== -->
        <!-- Workspace Header -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="8">

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Classes="heading"
                VerticalAlignment="Center"
                Text="Media Location"/>

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,2,0,0"
                Classes="caption"
                Text="Discover and analyse media stored in this location."/>

        </Grid>

        <!-- ===================================================== -->
        <!-- Location Information -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="2"
            Classes="card-secondary"
            Padding="12">

            <Grid
                ColumnDefinitions="*,320"
                RowDefinitions="Auto,12,Auto">

                <!-- ================================================= -->
                <!-- Card Header -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    ColumnDefinitions="*,Auto">

                    <TextBlock
                        Classes="section"
                        VerticalAlignment="Top"
                        Text="Media Location"/>

                    <Button
                        Grid.Column="1"
                        Width="180"
                        MinHeight="32"
                        Padding="12,4"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Theme="{StaticResource DJLM.PrimaryButton}"
                        Command="{Binding DiscoverMediaCommand}"
                        Content="🔍 Discover Media"/>

                </Grid>

                <!-- ================================================= -->
                <!-- Left Information -->
                <!-- ================================================= -->

                <StackPanel
                    Grid.Row="2"
                    Grid.Column="0"
                    Spacing="4">

                    <common:PropertyRow
                        Icon="🏷️"
                        Label="Name"
                        Value="{Binding Name}" />

                    <common:PropertyRow
                        Icon="📁"
                        Label="Path"
                        Value="{Binding Path}" />

                    <common:PropertyRow
                        Icon="💽"
                        Label="Drive"
                        Value="{Binding Drive}" />

                    <common:PropertyRow
                        ShowIndicator="True"
                        IndicatorBrush="{Binding StatusBrush}"
                        Label="Status"
                        Value="{Binding Status}" />

                </StackPanel>

                <!-- ================================================= -->
                <!-- Discovery Summary -->
                <!-- ================================================= -->

                <StackPanel
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    Spacing="4">

                    <common:PropertyRow
                        Icon="📁"
                        Label="Folders"
                        Value="{Binding FolderCountDisplay}" />

                    <common:PropertyRow
                        Icon="🎵"
                        Label="Audio Files"
                        Value="{Binding AudioFileCountDisplay}" />

                    <common:PropertyRow
                        Icon="🎬"
                        Label="Video Files"
                        Value="{Binding VideoFileCountDisplay}" />

                    <common:PropertyRow
                        Icon="💾"
                        Label="Total Size"
                        Value="{Binding TotalSize}" />

                </StackPanel>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- Discovered Media Folders -->
        <!-- ===================================================== -->

        <workflow:WorkflowMediaFolderTable
            Grid.Row="4"
            Libraries="{Binding Libraries}" />

    </Grid>

</UserControl>