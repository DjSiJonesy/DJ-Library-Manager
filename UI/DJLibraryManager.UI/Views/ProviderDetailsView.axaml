<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:common="using:DJLibraryManager.UI.Controls.Common"
    x:Class="DJLibraryManager.UI.Views.ProviderDetailsView"
    x:DataType="vm:ProviderWorkspaceViewModel"
    mc:Ignorable="d">

    <ScrollViewer>

        <Grid>

            <StackPanel
                Margin="30"
                MaxWidth="1000"
                HorizontalAlignment="Center"
                Spacing="24">

                <!-- Back -->

                <Button
                    HorizontalAlignment="Left"
                    Command="{Binding GoBackCommand}"
                    Content="← Dashboard"/>

                <!-- Provider -->

                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8">

                    <Border
                        Width="96"
                        Height="96"
                        CornerRadius="16"
                        ClipToBounds="True"
                        HorizontalAlignment="Center">

                        <Image
                            Source="{Binding ProviderLogo}"
                            Stretch="Uniform"/>

                    </Border>

                    <TextBlock
                        Classes="heading"
                        HorizontalAlignment="Center"
                        Text="{Binding ProviderName}"/>

                    <TextBlock
                        Classes="body"
                        HorizontalAlignment="Center"
                        Text="{Binding InstalledText}"/>

                    <TextBlock
                        Classes="caption"
                        HorizontalAlignment="Center"
                        Text="{Binding Version, StringFormat='Version {0}'}"/>

                </StackPanel>

                <!-- Installation -->

                <Border Classes="card">

                    <StackPanel Spacing="18">

                        <TextBlock
                            Classes="section"
                            Text="Installation"/>

                        <common:PropertyRow
                            Icon="📄"
                            Label="Executable"
                            Value="{Binding ExecutablePath}"/>

                        <common:PropertyRow
                            Icon="🗄️"
                            Label="Database"
                            Value="{Binding DatabasePath}"/>

                        <common:PropertyRow
                            Icon="⚙️"
                            Label="Settings"
                            Value="{Binding SettingsPath}"/>

                    </StackPanel>

                </Border>

                <!-- Library -->

                <Border Classes="card">

                    <StackPanel Spacing="20">

                        <TextBlock
                            Classes="section"
                            Text="Library"/>

                        <!-- Primary Actions -->

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15">

                            <Button
                                Grid.Column="0"
                                Theme="{StaticResource DJLM.PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding ImportLibraryCommand}"
                                IsEnabled="{Binding Provider.CanImport}"
                                Content="📥 Import Library"/>

                            <Button
                                Grid.Column="1"
                                Theme="{StaticResource DJLM.SecondaryButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Content="🔍 Analyse Library"
                                IsEnabled="{Binding Provider.CanAnalyse}"/>

                        </Grid>

                        <!-- Import Progress -->

                            <Border
                                Classes="card"
                                IsVisible="{Binding CurrentOperation.IsRunning}">

                                <StackPanel Spacing="12">

                                    <TextBlock
                                        Classes="section"
                                        Text="{Binding CurrentOperation.OperationName}"/>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding CurrentOperation.CurrentStage}"/>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Opacity="0.75"
                                        Text="{Binding CurrentOperation.CurrentItem}"/>

                                    <ProgressBar
                                        Height="8"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding CurrentOperation.Percentage}"
                                        IsIndeterminate="{Binding CurrentOperation.IsIndeterminate}"/>

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Text="{Binding CurrentOperation.CurrentValue}"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding CurrentOperation.Percentage, StringFormat='{}{0:F0}%'}"/>

                                    </Grid>

                                </StackPanel>

                            </Border>

                        <!-- Library Information -->

                        <Grid
                            ColumnDefinitions="170,*"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="12">

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontWeight="SemiBold"
                                Text="Status"/>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding Provider.LibraryStatus}"/>

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                FontWeight="SemiBold"
                                Text="Last Imported"/>

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Provider.LastImported}"/>

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                FontWeight="SemiBold"
                                Text="Tracks"/>

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding Provider.TrackCount}"/>

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                FontWeight="SemiBold"
                                Text="Playlists"/>

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="{Binding Provider.PlaylistCount}"/>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- Utilities -->

                <Border Classes="card">

                    <StackPanel Spacing="20">

                        <TextBlock
                            Classes="section"
                            Text="Utilities"/>

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="15"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="15">

                            <Button
                                Grid.Row="0"
                                Grid.Column="0"
                                Theme="{StaticResource DJLM.SecondaryButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding OpenInstallationFolderCommand}"
                                Content="💻 Installation Folder"/>

                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Theme="{StaticResource DJLM.SecondaryButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding OpenDatabaseFolderCommand}"
                                Content="📂 Database Folder"/>

                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Theme="{StaticResource DJLM.SecondaryButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding OpenSettingsFolderCommand}"
                                Content="⚙️ Settings Folder"/>

                        </Grid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>