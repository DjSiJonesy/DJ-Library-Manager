<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DJLibraryManager.UI.ViewModels"
    xmlns:common="using:DJLibraryManager.UI.Controls.Common"
    x:Class="DJLibraryManager.UI.Views.ProviderWorkspaceView"
    x:DataType="vm:ProviderWorkspaceViewModel"
    mc:Ignorable="d">

    <Grid>

    <StackPanel
        Margin="0"
        MaxWidth="1200"
        HorizontalAlignment="Stretch"
        Spacing="20">

            <!-- ===================================================== -->
            <!-- Workspace Header -->
            <!-- ===================================================== -->

           <Grid
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="20">

                <!-- Heading -->

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Classes="heading"
                    VerticalAlignment="Center"
                    Text="{Binding ProviderName, StringFormat='{}{0} Provider'}"/>

                <!-- Dashboard -->

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Theme="{StaticResource DJLM.SecondaryButton}"
                    Padding="12,4"
                    MinHeight="32"
                    Command="{Binding GoBackCommand}"
                    Content="← Dashboard"/>

                <!-- Description -->

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,2,0,0"
                    Classes="caption"
                    Text="Information about your installed DJ software, libraries and configuration."/>

            </Grid>
<!-- ===================================================== -->
<!-- Workspace Content -->
<!-- ===================================================== -->

<Grid
    ColumnDefinitions="220,*"
    ColumnSpacing="24">

  <!-- Provider Summary -->

<Border
    Grid.Column="0"
    Classes="card-secondary">

    <StackPanel
        Margin="16"
        HorizontalAlignment="Stretch"
        Spacing="12">

        <Border
            Width="64"
            Height="64"
            CornerRadius="12"
            ClipToBounds="True"
            HorizontalAlignment="Center">

            <Image
                Source="{Binding ProviderLogo}"
                Stretch="Uniform"/>

        </Border>

        <TextBlock
            Classes="heading"
            HorizontalAlignment="Center"
            Text="{Binding ProviderName}"/>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="8">

            <Ellipse
                Width="10"
                Height="10"
                VerticalAlignment="Center"
                Fill="{Binding StatusBrush}"/>

            <TextBlock
                Classes="body"
                VerticalAlignment="Center"
                Text="{Binding StatusText}"/>

        </StackPanel>

        <TextBlock
            Classes="caption"
            HorizontalAlignment="Center"
            Text="{Binding Version, StringFormat='Version {0}'}"/>

        <Button
            Margin="0,12,0,0"
            Height="44"
            Width="180"
            HorizontalAlignment="Center"
            HorizontalContentAlignment="Center"
            Theme="{StaticResource DJLM.PrimaryButton}"
            Command="{Binding ImportLibraryCommand}"
            IsEnabled="{Binding Provider.CanImport}"
            Content="📥 Import Library"/>

    </StackPanel>

</Border>

                <!-- Installation -->

                <Border
                    Grid.Column="1"
                    Classes="card-secondary">

                    <StackPanel Spacing="18">

                        <TextBlock
                            Classes="section"
                            Text="Installation"/>

                        <!-- Executable -->

                        <Button
                            Theme="{StaticResource DJLM.SecondaryButton}"
                            Height="72"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Command="{Binding OpenInstallationFolderCommand}">

                            <StackPanel
                                Margin="8"
                                Spacing="6">

                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="💻  Executable"/>

                                <TextBlock
                                    Classes="caption"
                                    Text="{Binding ExecutablePath}"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Button>

                        <!-- Database -->

                        <Button
                            Theme="{StaticResource DJLM.SecondaryButton}"
                            Height="72"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Command="{Binding OpenDatabaseFolderCommand}">

                            <StackPanel
                                Margin="8"
                                Spacing="6">

                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="🗄️  Database"/>

                                <TextBlock
                                    Classes="caption"
                                    Text="{Binding DatabasePath}"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Button>

                        <!-- Settings -->

                        <Button
                            Theme="{StaticResource DJLM.SecondaryButton}"
                            Height="72"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Command="{Binding OpenSettingsFolderCommand}">

                            <StackPanel
                                Margin="8"
                                Spacing="6">

                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="⚙️  Settings"/>

                                <TextBlock
                                    Classes="caption"
                                    Text="{Binding SettingsPath}"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Border>

            </Grid>

                <!-- Library -->

                <Border Classes="card-secondary">

                    <StackPanel Spacing="20">

                        <TextBlock
                            Classes="section"
                            Text="Library"/>

                        <!-- Primary Actions -->

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15">

                                                       
                        </Grid>

                        <!-- Import Progress -->

                            <Border
                                Classes="card"
                                IsVisible="{Binding CurrentOperation.IsRunning}">

                                <StackPanel Spacing="12">

                                    <TextBlock
                                        Classes="section"
                                        Text="Import Progress"/>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        FontSize="16"
                                        Text="{Binding CurrentOperation.OperationName}"/>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding CurrentOperation.CurrentStage}"/>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Opacity="0.75"
                                        Text="{Binding CurrentOperation.CurrentItem}"/>

                                    <ProgressBar
                                        Height="8"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding CurrentOperation.Percentage}"
                                        IsIndeterminate="{Binding CurrentOperation.IsIndeterminate}"/>

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Text="{Binding CurrentOperation.CurrentValue}"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding CurrentOperation.Percentage, StringFormat='{}{0:F0}%'}"/>

                                    </Grid>

                                </StackPanel>

                            </Border>

                            <!-- Library Information -->

                            <StackPanel Spacing="8">

                            <!-- ===================================================== -->
                            <!-- Status -->
                            <!-- ===================================================== -->

                            <Grid
                                ColumnDefinitions="36,110,*"
                                ColumnSpacing="16"
                                Margin="0,4">

                                <!-- Status Indicator -->

                                <Ellipse
                                    Width="16"
                                    Height="16"
                                    Fill="{Binding Provider.LibraryStatusBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <!-- Label -->

                                <TextBlock
                                    Grid.Column="1"
                                    Classes="subheading"
                                    VerticalAlignment="Center"
                                    Text="Status"/>

                                <!-- Value -->

                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="16"                                    
                                    Text="{Binding Provider.LibraryStatus}"/>

                            </Grid>

                                <!-- Remaining Library Properties -->

                                <common:PropertyRow
                                    Icon="📅"
                                    Label="Last Imported"
                                    Value="{Binding Provider.LastImported}"/>

                                <common:PropertyRow
                                    Icon="🎵"
                                    Label="Tracks"
                                    Value="{Binding Provider.TrackCount, StringFormat={}{0:N0}}"/>

                                <common:PropertyRow
                                    Icon="📂"
                                    Label="Playlists"
                                    Value="{Binding Provider.PlaylistCount, StringFormat={}{0:N0}}"/>

                            </StackPanel>

                    </StackPanel>

                </Border>

       </StackPanel>

    </Grid>

</UserControl>